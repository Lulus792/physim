{
  "format": 1,
  "formulas": [
    {
      "id": "pendulum-small-angle",
      "tex": "T_0=2\\pi\\sqrt{\\frac{L}{g}}",
      "reading": "T₀ = 2π√(L/g)"
    },
    {
      "id": "pendulum-energy",
      "tex": "E=\\frac{1}{2}mL^2\\omega^2+mgL\\left(1-\\cos\\theta\\right)",
      "reading": "E = ½mL²ω² + mgL(1 − cos θ)"
    },
    {
      "id": "pendulum-period",
      "tex": "T=4\\sqrt{\\frac{L}{g}}\\,K\\!\\left(\\sin\\frac{|\\theta_0|}{2}\\right)",
      "reading": "T = 4√(L/g) K(sin(|θ₀|/2))"
    },
    {
      "id": "elliptic-integral",
      "tex": "K(k)=\\int_0^{\\pi/2}\\frac{\\mathrm{d}\\varphi}{\\sqrt{1-k^2\\sin^2\\varphi}}",
      "reading": "K(k) = ∫₀^(π/2) 1/√(1 − k² sin² φ) dφ"
    },
    {
      "id": "pendulum-dynamics",
      "tex": "\\theta'=\\omega,\\qquad \\omega'=-\\frac{g}{L}\\sin\\theta",
      "reading": "θ′ = ω; ω′ = −(g/L) sin θ"
    },
    {
      "id": "pendulum-position",
      "tex": "x=L\\sin\\theta,\\qquad y=-L\\cos\\theta",
      "reading": "x = L sin θ; y = −L cos θ"
    },
    {
      "id": "projectile-x",
      "tex": "x(t)=-2+2t",
      "reading": "x(t) = −2 + 2t"
    },
    {
      "id": "projectile-y",
      "tex": "y(t)=5t-\\frac{1}{2}\\cdot 9{,}80665\\,t^2",
      "reading": "y(t) = 5t − ½ · 9,80665 t²"
    },
    {
      "id": "projectile-vx",
      "tex": "v_x(t)=2",
      "reading": "vₓ(t) = 2"
    },
    {
      "id": "projectile-vy",
      "tex": "v_y(t)=5-9{,}80665\\,t",
      "reading": "vᵧ(t) = 5 − 9,80665 t"
    },
    {
      "id": "projectile-energy",
      "tex": "E(t)=\\frac{1}{2}\\left(v_x^2+v_y^2\\right)+gy=14{,}5\\,\\mathrm{J}",
      "reading": "E(t) = ½(vₓ² + vᵧ²) + gy = 14,5 J"
    },
    {
      "id": "projectile-motion",
      "tex": "\\frac{\\mathrm{d}\\mathbf{r}}{\\mathrm{d}t}=\\mathbf{v}",
      "reading": "dr/dt = v"
    },
    {
      "id": "quadratic-drag",
      "tex": "\\mathbf{F}_{\\mathrm{drag}}=-\\frac{1}{2}\\rho C_d A\\lvert\\mathbf{v}\\rvert\\mathbf{v}",
      "reading": "F_drag = −½ρ C_d A |v| v"
    },
    {
      "id": "projectile-acceleration",
      "tex": "\\frac{\\mathrm{d}\\mathbf{v}}{\\mathrm{d}t}=(0,-g)+\\frac{\\mathbf{F}_{\\mathrm{drag}}}{m}",
      "reading": "dv/dt = (0, −g) + F_drag/m"
    },
    {
      "id": "projectile-drag-energy",
      "tex": "E=\\frac{1}{2}m\\lvert\\mathbf{v}\\rvert^2+mgy",
      "reading": "E = ½m|v|² + mgy"
    },
    {
      "id": "sphere-volume",
      "tex": "V=\\frac{4}{3}\\pi r^3,\\qquad m=\\rho_s V",
      "reading": "V = (4/3)πr³; m = ρₛV"
    },
    {
      "id": "sphere-weight",
      "tex": "F_G=-mg",
      "reading": "F_G = −mg"
    },
    {
      "id": "sphere-buoyancy",
      "tex": "F_A=\\rho_f Vg",
      "reading": "F_A = ρ_f Vg"
    },
    {
      "id": "stokes-drag",
      "tex": "F_D=-6\\pi\\mu rv",
      "reading": "F_D = −6πμrv"
    },
    {
      "id": "stokes-decay",
      "tex": "\\lambda=\\frac{6\\pi\\mu r}{m}",
      "reading": "λ = 6πμr/m"
    },
    {
      "id": "sphere-position-rate",
      "tex": "\\dot{y}=v",
      "reading": "y′ = v"
    },
    {
      "id": "sphere-velocity-rate",
      "tex": "\\dot{v}=\\frac{F_G+F_A+F_D}{m}",
      "reading": "v′ = (F_G + F_A + F_D)/m"
    },
    {
      "id": "sphere-reynolds",
      "tex": "\\mathrm{Re}=\\frac{2r\\rho_f\\lvert v\\rvert}{\\mu}",
      "reading": "Re = 2rρ_f|v|/μ"
    },
    {
      "id": "stokes-speed",
      "tex": "v(t)=\\frac{a}{\\lambda}\\left(1-e^{-\\lambda t}\\right)",
      "reading": "v(t) = (a/λ)(1 − exp(−λt))"
    },
    {
      "id": "stokes-position",
      "tex": "y(t)=y_0+\\frac{a}{\\lambda}\\left(t-\\frac{1-e^{-\\lambda t}}{\\lambda}\\right)",
      "reading": "y(t) = y₀ + (a/λ)(t − (1 − exp(−λt))/λ)"
    },
    {
      "id": "stokes-terminal",
      "tex": "v_{\\infty}=\\frac{a}{\\lambda}",
      "reading": "v∞ = a/λ"
    },
    {
      "id": "sphere-kinetic",
      "tex": "E_{\\mathrm{kin}}=\\frac{mv^2}{2}",
      "reading": "E_kin = mv²/2"
    },
    {
      "id": "sphere-potential",
      "tex": "E_{\\mathrm{pot}}=-\\left(F_G+F_A\\right)y",
      "reading": "E_pot = −(F_G + F_A)y"
    },
    {
      "id": "sphere-dissipation",
      "tex": "\\dot{E}_{\\mathrm{diss}}=-F_Dv",
      "reading": "E_diss′ = −F_D v"
    },
    {
      "id": "sphere-balance",
      "tex": "E_{\\mathrm{Bilanz}}=E_{\\mathrm{kin}}+E_{\\mathrm{pot}}+E_{\\mathrm{diss}}\\approx E_{\\mathrm{Bilanz}}(0)",
      "reading": "E_Bilanz = E_kin + E_pot + E_diss ≈ E_Bilanz(0)"
    },
    {
      "id": "spring-equation",
      "tex": "m\\ddot{x}+c\\dot{x}+kx=0",
      "reading": "mx″ + cx′ + kx = 0"
    },
    {
      "id": "spring-force",
      "tex": "F_{\\mathrm{spring}}=-kx",
      "reading": "Federkraft = −kx"
    },
    {
      "id": "spring-damping",
      "tex": "F_{\\mathrm{damping}}=-cv",
      "reading": "Dämpfungskraft = −cv"
    },
    {
      "id": "spring-energy",
      "tex": "E_{\\mathrm{mech}}=\\frac{mv^2}{2}+\\frac{kx^2}{2}",
      "reading": "E_mechanisch = mv²/2 + kx²/2"
    },
    {
      "id": "spring-dissipation",
      "tex": "\\frac{\\mathrm{d}E_{\\mathrm{diss}}}{\\mathrm{d}t}=cv^2",
      "reading": "dE_dissipiert/dt = cv²"
    },
    {
      "id": "spring-balance",
      "tex": "E_{\\mathrm{Bilanz}}=E_{\\mathrm{mech}}+E_{\\mathrm{diss}}\\approx E_{\\mathrm{mech}}(0)",
      "reading": "E_Bilanz = E_mechanisch + E_dissipiert ≈ E_mechanisch(0)"
    },
    {
      "id": "stokes-effective-gravity",
      "tex": "a=-g\\left(1-\\frac{\\rho_f}{\\rho_s}\\right)",
      "reading": "a = −g(1 − ρ_f/ρₛ)"
    },
    {
      "id": "vacuum-speed",
      "tex": "v=at",
      "reading": "v = at"
    },
    {
      "id": "vacuum-position",
      "tex": "y=y_0+\\frac{at^2}{2}",
      "reading": "y = y₀ + at²/2"
    },
    {
      "id": "spring-frequency",
      "tex": "\\omega_0=\\sqrt{\\frac{k}{m}}",
      "reading": "ω₀ = √(k/m)"
    },
    {
      "id": "spring-decay",
      "tex": "\\alpha=\\frac{c}{2m}",
      "reading": "α = c/(2m)"
    },
    {
      "id": "spring-underdamped",
      "tex": "x(t)=e^{-\\alpha t}\\left(A\\cos(\\omega t)+B\\sin(\\omega t)\\right)",
      "reading": "x(t) = exp(−αt)(A cos(ωt) + B sin(ωt))"
    },
    {
      "id": "spring-damped-frequency",
      "tex": "\\omega=\\sqrt{\\omega_0^2-\\alpha^2}",
      "reading": "ω = √(ω₀² − α²)"
    },
    {
      "id": "spring-critical",
      "tex": "x(t)=(A+Bt)e^{-\\alpha t}",
      "reading": "x(t) = (A + Bt) exp(−αt)"
    },
    {
      "id": "pendulum-dissipation",
      "tex": "\\dot{D}=-\\mathbf{F}_{\\mathrm{drag}}\\cdot\\mathbf{v}=\\frac{1}{2}\\rho C_d A\\lvert L\\omega\\rvert^3",
      "reading": "D′ = −F_drag · v = ½ρ C_d A |Lω|³"
    },
    {
      "id": "pendulum-balance",
      "tex": "E(t)+D(t)=E(0)",
      "reading": "E(t) + D(t) = E(0)"
    },
    {
      "id": "pendulum-radial",
      "tex": "\\mathbf{e}_r=(\\sin\\theta,-\\cos\\theta)",
      "reading": "eᵣ = (sin θ, −cos θ)"
    },
    {
      "id": "pendulum-weight",
      "tex": "\\mathbf{F}_G=(0,-mg)",
      "reading": "F_G = (0, −mg)"
    },
    {
      "id": "pendulum-rod",
      "tex": "\\mathbf{F}_{\\mathrm{Stange}}=-m\\left(g\\cos\\theta+L\\omega^2\\right)\\mathbf{e}_r",
      "reading": "F_Stange = −m(g cos θ + Lω²)eᵣ"
    },
    {
      "id": "pendulum-position-phi-x",
      "tex": "x=L\\sin\\varphi",
      "reading": "x = L sin φ"
    },
    {
      "id": "pendulum-position-phi-y",
      "tex": "y=-L\\cos\\varphi",
      "reading": "y = −L cos φ"
    },
    {
      "id": "pendulum-velocity-x",
      "tex": "v_x=L\\cos\\varphi\\,\\omega",
      "reading": "vₓ = L cos φ · ω"
    },
    {
      "id": "pendulum-velocity-y",
      "tex": "v_y=L\\sin\\varphi\\,\\omega",
      "reading": "vᵧ = L sin φ · ω"
    },
    {
      "id": "pendulum-speed",
      "tex": "\\lvert\\mathbf{v}\\rvert=L\\lvert\\omega\\rvert",
      "reading": "speed = L|ω|"
    },
    {
      "id": "logarithmic-decrement",
      "tex": "\\delta=\\ln A_1-\\ln A_2",
      "reading": "δ = ln A₁ − ln A₂"
    },
    {
      "id": "amplitude-decay-rate",
      "tex": "r=\\frac{\\delta}{t_2-t_1}",
      "reading": "r = δ/(t₂ − t₁)"
    },
    {
      "id": "collision-approach",
      "tex": "g=u_A-u_B>0",
      "reading": "g = u_A − u_B > 0"
    },
    {
      "id": "collision-total-mass",
      "tex": "M=m_A+m_B",
      "reading": "M = m_A + m_B"
    },
    {
      "id": "collision-reduced-mass",
      "tex": "\\mu=\\frac{m_A m_B}{M}",
      "reading": "μ = m_A m_B/M"
    },
    {
      "id": "collision-time",
      "tex": "t_c=\\frac{2-2r}{g}=\\frac{1{,}6}{g}",
      "reading": "t_c = (2 − 2r)/g = 1,6/g"
    },
    {
      "id": "collision-impulse",
      "tex": "J=(1+e)\\mu g",
      "reading": "J = (1 + e)μg"
    },
    {
      "id": "collision-velocity-a",
      "tex": "v_A=u_A-\\frac{J}{m_A}",
      "reading": "v_A = u_A − J/m_A"
    },
    {
      "id": "collision-velocity-b",
      "tex": "v_B=u_B+\\frac{J}{m_B}",
      "reading": "v_B = u_B + J/m_B"
    },
    {
      "id": "collision-momentum",
      "tex": "P=m_A v_A+m_B v_B",
      "reading": "P = m_A v_A + m_B v_B"
    },
    {
      "id": "collision-energy",
      "tex": "K=\\frac{1}{2}m_A v_A^2+\\frac{1}{2}m_B v_B^2",
      "reading": "K = ½m_A v_A² + ½m_B v_B²"
    },
    {
      "id": "collision-dissipation",
      "tex": "D=\\frac{1}{2}\\mu(1-e^2)g^2",
      "reading": "D = ½μ(1 − e²)g²"
    }
  ]
}
