# Preserve pinned upstream font and license bytes across Windows/Linux checkouts.
third_party/fonts/*.ttf binary
third_party/fonts/*-OFL.txt -text

# Keep the pinned line-break sources, licenses and manifest byte-identical.
third_party/libunibreak-8.0/** -text
third_party/libunibreak-8.0/*.gz binary
third_party/libunibreak-8.0/manifest.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Formula hashes and compressed coverage must survive every checkout unchanged.
docs/formulas/*.json text eol=lf
docs/formulas/*.svg -text
docs/formulas/*.math binary
docs/formulas/*LICENSE*.txt -text
docs/formulas/NOTICE.txt text eol=lf
app/documentation_math_catalog.inc text eol=lf

# Frozen transport proofs keep their audited blob bytes on every checkout.
docs/visuals/unified-workspace/transport-2026-10-23/* text eol=lf
docs/visuals/unified-workspace/transport-2026-10-23/*.png binary
docs/visuals/unified-workspace/transport-2026-10-23/*.gz binary

# Frozen timeline proofs retain audited bytes across checkout platforms.
docs/visuals/unified-workspace/timeline-2026-10-23/* text eol=lf
docs/visuals/unified-workspace/timeline-2026-10-23/*.png binary
docs/visuals/unified-workspace/timeline-2026-10-23/*.gz binary

# Inspector native captures and execution records keep their verified bytes.
docs/visuals/unified-workspace/inspector-tree-2026-10-23/* text eol=lf
docs/visuals/unified-workspace/inspector-tree-2026-10-23/*.png binary
docs/visuals/unified-workspace/inspector-tree-2026-10-23/*.gz binary

# Frozen selected-object proofs retain the same bytes across platforms.
docs/visuals/unified-workspace/object-properties-2026-10-23/* text eol=lf
docs/visuals/unified-workspace/object-properties-2026-10-23/*.png binary
docs/visuals/unified-workspace/object-properties-2026-10-23/*.gz binary
