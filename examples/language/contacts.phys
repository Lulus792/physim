// Pair contacts use value results: explicitly adopt bodyA/bodyB after solving.
let zero = Vec3(0,0,0)
let identity = Quat(0,0,0,1)
let defaults = ContactSolver.defaults()
assert(defaults.iterations > 0 && defaults.friction >= 0 && defaults.restitution >= 0)
let elastic = ContactSolver(iterations: 64, restitution: 1, friction: 0,
    bounceThreshold: 0, penetrationSlop: 0, correctionFraction: 1)
var a = Body.sphere(1,0.5)
var b = Body.sphere(1,0.5)
a.setState(Vec3(-0.5,0,0),Vec3(1,0,0),identity,zero)
b.setState(Vec3(0.5,0,0),Vec3(-1,0,0),identity,zero)
let touching: Contacts = Contacts.spheres(a,0.5,b,0.5)
assert(touching.count == 1 && touching.normal(0).x == 1)
assert(touching.point(0).length() == 0 && touching.penetration(0) == 0)
let collision: ContactResult = touching.resolve(bodyB: b, solver: elastic, bodyA: a)
assert(collision.count == 1 && abs(collision.impulse(0).x + 2) < 1e-12)
assert(collision.bodyA.velocity.x == -1 && collision.bodyB.velocity.x == 1)
assert(a.velocity.x == 1 && b.velocity.x == -1)
assert(abs(collision.bodyA.kineticEnergy() + collision.bodyB.kineticEnergy() - 1) < 1e-12)
assert(collision.maxNormalError < 1e-12)
var results = [collision]
let preserved = results
let separated = Contacts.spheres(a,0.1,b,0.1)
assert(separated.count == 0)
results[0] = separated.resolve(a,b,defaults)
assert(results[0].bodyA.velocity.x == 1 && preserved[0].bodyA.velocity.x == -1)

// Frictional sphere-plane impact: the world is an explicit mass-zero body.
let fixed = Body.box(0,Vec3(1,1,1))
a.setState(Vec3(0,0.5,0),Vec3(1,-1,0),identity,zero)
let plane = Contacts.spherePlane(a,0.5,zero,Vec3(0,1,0))
let friction = ContactSolver(64,0,0.2,0,0,1)
let impact = plane.resolve(a,fixed,friction)
assert(abs(impact.impulse(0).y - 1) < 1e-12 && abs(impact.impulse(0).x + 0.2) < 1e-12)
assert(abs(impact.bodyA.velocity.x - 0.8) < 1e-12 && abs(impact.bodyA.velocity.y) < 1e-12)
assert(abs(impact.bodyA.angularVelocity.z + 1) < 1e-12)
assert(abs(impact.bodyA.kineticEnergy() - 0.37) < 1e-12)
assert(impact.bodyB.mass == 0 && impact.bodyB.position.length() == 0)

a.setState(Vec3(-1,0,0),Vec3(1,0,0),identity,zero)
let sphereBox = Contacts.sphereBox(a,0.5,fixed,Vec3(1,1,1))
assert(sphereBox.count == 1 && sphereBox.normal(0).x == 1)
assert(sphereBox.resolve(a,fixed,elastic).bodyA.velocity.x == -1)

var boxA = Body.box(1,Vec3(1,1,1))
var boxB = boxA
boxB.setState(Vec3(0.75,0,0),zero,identity,zero)
let boxes = Contacts.boxes(boxA,Vec3(1,1,1),boxB,Vec3(1,1,1))
assert(boxes.count > 0 && boxes.count <= 8)
let projection = boxes.resolve(boxA,boxB,elastic)
assert(abs(projection.bodyB.position.x - projection.bodyA.position.x - 1) < 1e-12)
boxA.setState(Vec3(0,0.5,0),zero,identity,zero)
let floor = Contacts.boxPlane(boxA,Vec3(1,1,1),zero,Vec3(0,1,0))
assert(floor.count == 4)
for i in 0..<floor.count:
    assert(floor.point(i).y == 0 && floor.normal(i).y == -1 && floor.penetration(i) == 0)
let atRest = floor.resolve(boxA,fixed,defaults)
assert(atRest.count == 4 && atRest.maxNormalError == 0)
print("contact checks passed")
