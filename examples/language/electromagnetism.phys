// Homogeneous electrostatics and a constant-source series RC circuit, all SI.
assert(expm1(1e-20) == 1e-20)
assert(attempt(expm1(1000)) == nil)
let epsilon = vacuumPermittivity()
let field = pointChargeField(1e-9,Vec3(0,0,0),Vec3(1,0,0),epsilon)
let potential = pointChargePotential(1e-9,Vec3(0,0,0),Vec3(1,0,0),epsilon)
assert(abs(field.x-8.987551786170817) < 1e-10 && field.y == 0 && field.z == 0)
assert(abs(potential-field.x) < 1e-12)
let force = lorentzForce(2,Vec3(1,2,3),Vec3(4,0,0),Vec3(0,0,5))
assert(force.x == 2 && force.y == -36 && force.z == 6)
assert(resistorCurrent(-12,100) == -0.12)
assert(resistorVoltage(-0.12,100) == -12)
assert(abs(resistorPower(-12,100)-1.44) < 1e-14)
assert(seriesResistance(100,300) == 400)
assert(abs(parallelResistance(100,300)-75) < 1e-12)
assert(abs(capacitorEnergy(0.002,12)-0.144) < 1e-14)
let charged = rcVoltageStep(1000,0.002,0,12,2)
assert(abs(charged-7.585446705942692) < 1e-12)
let half = rcVoltageStep(1000,0.002,0,12,1)
assert(abs(rcVoltageStep(1000,0.002,half,12,1)-charged) < 1e-12)
assert(attempt(pointChargeField(1,Vec3(0,0,0),Vec3(0,0,0),epsilon)) == nil)
assert(attempt(resistorCurrent(12,0)) == nil)
assert(attempt(rcVoltageStep(1000,0.002,0,12,-1)) == nil)
var copies = [field,force]
let original = copies
copies[0] = Vec3(0,0,0)
assert(original[0].x == field.x)
print("Electromagnetism fields, force, circuits, exact RC and caught errors passed")
