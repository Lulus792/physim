// Adaptive RK45 callback with the vacuum parameters of the C pendulum.
let length = parameter("length", 1.5, 0.1, 10, "Pendulum length in metres")
let initialAngle = parameter("initialAngle", 0.45, -1.5, 1.5, "Initial angle in radians")
let gravity: Float64 = 9.80665
let radians = Unit(0, 0, 0, 0, 0, 0, 0, 1, "rad")
let angularRate = Unit(0, 0, -1, 0, 0, 0, 0, 1, "rad/s")
let metres = Unit(1, 0, 0, 0, 0, 0, 0, 1, "m")
let joules = Unit(2, 1, -2, 0, 0, 0, 0, 1, "J")
let angleChannel = Channel("angle", radians, "True pendulum angle")
let rateChannel = Channel("angular_velocity", angularRate, "Angular velocity")
let xChannel = Channel("position.x", metres, "Horizontal position")
let yChannel = Channel("position.y", metres, "Vertical position")
let energyChannel = Channel("energy", joules, "Kinetic plus gravitational potential energy")
let sensorChannel = Channel("sensor.angle", radians, "Angle without sensor noise")
struct PendulumState:
    let phase: Vec2
    func advanced(time: Float64, dt: Float64) -> PendulumState:
        let next = rk45IntegrateWithSteps(pendulumDerivative, [self.phase.x, self.phase.y],
                                          time, time + dt, 1e-10, 1e-8, 100000,
                                          dt, 1e-14, dt)
        return PendulumState(Vec2(next[0], next[1]))
    mutating func advance(time: Float64, dt: Float64):
        self = self.advanced(time, dt)
var states = [PendulumState(Vec2(initialAngle, 0))]

func pendulumDerivative(time: Float64, state: [Float64]) -> [Float64]:
    return [state[1], -gravity / length * sin(state[0])]

func measure():
    for value in states:
        let state = value.phase
        angleChannel.sample(state.x)
        rateChannel.sample(state.y)
        xChannel.sample(length * sin(state.x))
        yChannel.sample(-length * cos(state.x))
        energyChannel.sample(0.5 * length * length * state.y * state.y + gravity * length * (1 - cos(state.x)))
        sensorChannel.sample(state.x)

func create():
    metadata("model=point pendulum, vacuum\nlength_m=" + String(length) + "\ninitial_angle_rad=" + String(initialAngle) + "\nmass_kg=1\ngravity_m_s2=9.80665\nintegrator=Dormand-Prince 5(4)\nrk45_absolute_tolerance=1e-10\nrk45_relative_tolerance=1e-8\nsensor_noise_rad=0\nadaptive_integrator=Dormand-Prince 5(4)\nadaptive_absolute_tolerance=1e-10\nadaptive_relative_tolerance=1e-8")

func reset():
    states = []
    states.append(PendulumState(Vec2(initialAngle, 0)))
    measure()

func step(dt: Float64):
    states[0].advance(simulationTime(), dt)
    measure()

func scene():
    let state = states[0].phase
    let origin = Vec3(0, 0, 0)
    let bob = Vec3(length * sin(state.x), -length * cos(state.x), 0)
    line(origin, bob, 0, 0xB5C4D8FF, 1)
    sphere(origin, 0.045, 0xE6EDF3FF, 2)
    sphere(bob, 0.12, 0x53DEC2FF, 3)

    group("Pendel", 100, 0)
    group("Bewegte Masse", 101, 100)
    sceneParent(1, 100)
    sceneParent(2, 100)
    sceneParent(3, 101)

// One accepted Dormand-Prince step; rejected trials never update model state.
func adaptiveDerivative(time: Float64, state: [Float64]) -> [Float64]:
    return [state[1], -gravity / length * sin(state[0])]

func adaptiveStep(dt: Float64, minimum: Float64, maximum: Float64) -> StepInterval:
    let phase = states[0].phase
    let time = simulationTime()
    let result = rk45StepReported(adaptiveDerivative, [phase.x, phase.y], time, time + dt,
                                  1e-10, 1e-8, 100000, dt, minimum, maximum)
    states[0] = PendulumState(Vec2(result.state[0], result.state[1]))
    measure()
    return StepInterval(result.reachedTime - time, result.nextStep)
