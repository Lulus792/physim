// Constant capacities, Kelvin and SI; independent ideal-gas and conduction models.
let capacity = heatCapacity(mass: 2, specificHeat: 500)
let heat = sensibleHeat(capacity,300,350)
assert(capacity == 1000 && heat == 50000)
assert(heatFlow(20,350,300) == 1000)
let pressure = idealGasPressure(amount: 1,temperature: 300,volume: 0.025)
assert(abs(pressure - 99773.55141783888) < 1e-8)
assert(abs(idealGasVolume(1,300,pressure)-0.025) < 1e-14)
assert(abs(idealGasTemperature(1,pressure,0.025)-300) < 1e-10)
assert(idealGasEnergy(2,12.5,400) == 10000)
let entropy = idealGasEntropyChange(2,12.5,300,0.025,600,0.05)
assert(abs(entropy-28.8549721572865916498768547526702969538865614511747999448447) < 1e-10)
let cooled = thermalReservoirStep(100,400,300,5,20)
assert(abs(cooled-336.78794411714423) < 1e-10)
let pair = thermalPairStep(100,400,300,300,5,15)
assert(abs(pair.x-352.59095808785815) < 1e-10)
assert(abs(pair.y-315.80301397071394) < 1e-10)
assert(abs(100*pair.x+300*pair.y-130000) < 1e-8)
var states = [pair,thermalPairStep(100,pair.x,300,pair.y,5,15)]
let original = states
states[0] = Vec2(300,300)
assert(original[0].x == pair.x)
assert(attempt(idealGasPressure(1,0,1)) == nil)
assert(attempt(thermalPairStep(100,400,300,300,-1,1)) == nil)
assert(attempt(heatCapacity(1e308,1e308)) == nil)
print("Thermodynamics gas, heat, entropy, exchange and caught errors passed")
