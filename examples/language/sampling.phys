// Integrate velocity on an integer-indexed grid using the trapezoidal rule.
let steps: Int64 = 100
let duration = 2.0
let dt = duration / Float64(steps)
let initialSpeed = 3.0
let gravity = 9.80665
var displacement = 0.0
for index in 0..<steps:
    let start = Float64(index) * dt
    let end = Float64(index + 1) * dt
    let leftSpeed = initialSpeed - gravity * start
    let rightSpeed = initialSpeed - gravity * end
    displacement = displacement + 0.5 * (leftSpeed + rightSpeed) * dt
let reference = initialSpeed * duration - 0.5 * gravity * duration * duration
assert(abs(displacement - reference) < 1e-12)
print(displacement)
