import Values

struct Cell:
    let values: [Int64]

func identity<T>(value: T) -> T:
    return value

func singleton<T>(value: T) -> [T]:
    return [value]

let number = identity(42)
let decimal = identity(1.5)
let contextual: Float64 = identity(2)
let copied = identity([3, 4])
let single = singleton(7)
let optional = Values.wrap([8, 9])
let recovered = Values.unwrap(optional)
let cell = identity(Cell([10, 12]))
let repeatedCell = Values.repeat(cell, 2)
let empty = Values.keepArray(values: [], sample: 6)
let absent = Values.keepOptional(value: nil, sample: 6)
let positionalEmpty = Values.keepArray([], 7)
let contextualEmpty: [Int64] = identity([])
let contextualAbsent: Int64? = identity(nil)
var slots = [Values.Slot(0)]
let echoed = slots[0].echo([30, 31])
let taken = slots[0].take([32, 33])
let staticCopy = Values.Slot.copy(Optional.some(34))
let again = slots[0].echoAgain([35, 36])
let repeatedMethod = Values.Slot.repeat([37, 38], 2)
let explicitFloat = identity<Float64>(2)
let explicitEmpty = identity<[Int64]>([])
let explicitNil = identity<Int64?>(nil)
let explicitPair = Values.keep<Int64, Float64>(left: 39, right: 40)
let explicitRecord = identity<Values.Slot>(Values.Slot(41))
let explicitMethod = slots[0].echo<Float64>(42)
let explicitStatic = Values.Slot.copy<[Int64]>([43, 44])
var boxes = [Values.Box<[Int64]>([45, 46])]
let oldBoxValue = boxes[0].replace([47, 48])
let staticBox = Values.Box<Int64>.wrap(49)
let nestedBox: Values.Box<Values.Box<Int64>> = Values.Box<Values.Box<Int64>>(staticBox)
let pair = Values.Pair<Int64, Float64>(50, 51.0)
let genericMethod = boxes[0].echo<String>("ok")
let floatBox = Values.Box<Float64>(1.5)
let node = Values.Node<Int64>(52, nil)
let unboxed = Values.unbox<Int64>(staticBox)
let copiedGenericBox = identity<Values.Box<Int64>>(staticBox)
let inferredBox = Values.Box(53)
let inferredArrayBox: Values.Box<[Int64]> = Values.Box([])
let inferredPair = Values.Pair(second: 55.0, first: 54)
let inferredNode = Values.Node(56, nil)
let inferredUnbox = Values.unbox(inferredBox)
let inferredNested = Values.Box(Values.Box(57))
let inferredFloat: Values.Box<Float64> = Values.Box(58)
let inferredFloatValue: Float64 = Values.unbox(inferredFloat)
let numericInt = Values.add(59, 60)
let numericFloat = Values.add<Float64>(1, 2.5)
let inferredNumericFloat = Values.add(1, 2.5)
let inferredNegativeFloat = Values.add(-1, 2.5)
let inferredNamedFloat = Values.add(right: 2.5, left: -1)
let inferredOptionalFloat = Values.keepOptional(value: Optional.some(1), sample: 2.5)
let inferredArrayFloat = Values.keepArray(values: [1, 2], sample: 3.5)
let methodOptionalFloat = slots[0].keepOptional(value: Optional.some(1), sample: 2.5)
let staticArrayFloat = Values.Slot.keepArray(values: [1, 2], sample: 3.5)
let scalarBox = Values.ConstrainedBox("text")
let constrainedMethod = scalarBox.echo(61)
let vectorDouble = Values.doubled(Vec2(2, 3))

assert(number == 42)
assert(decimal == 1.5)
assert(contextual == 2.0)
assert(copied[1] == 4)
assert(single[0] == 7)
assert(recovered[1] == 9)
assert(cell.values[0] == 10)
assert(repeatedCell.values[1] == 12)
assert(empty.count == 0)
assert(absent == nil)
assert(positionalEmpty.count == 0)
assert(contextualEmpty.count == 0)
assert(contextualAbsent == nil)
assert(echoed[1] == 31)
assert(taken[0] == 32)
assert(slots[0].count == 1)
assert(staticCopy.unwrap() == 34)
assert(again[0] == 35)
assert(repeatedMethod[1] == 38)
assert(explicitFloat == 2.0)
assert(explicitEmpty.count == 0)
assert(explicitNil == nil)
assert(explicitPair == 39)
assert(explicitRecord.count == 41)
assert(explicitMethod == 42.0)
assert(explicitStatic[1] == 44)
assert(oldBoxValue[1] == 46)
assert(boxes[0].value[0] == 47)
assert(boxes[0].get()[1] == 48)
assert(staticBox.value == 49)
assert(nestedBox.value.value == 49)
assert(pair.first == 50)
assert(pair.second == 51.0)
assert(genericMethod == "ok")
assert(floatBox.get() == 1.5)
assert(node.value == 52)
assert(node.next == nil)
assert(unboxed == 49)
assert(copiedGenericBox.get() == 49)
assert(inferredBox.get() == 53)
assert(inferredArrayBox.value.count == 0)
assert(inferredPair.first == 54)
assert(inferredPair.second == 55.0)
assert(inferredNode.next == nil)
assert(inferredUnbox == 53)
assert(inferredNested.value.value == 57)
assert(inferredFloatValue == 58.0)
assert(numericInt == 119)
assert(numericFloat == 3.5)
assert(inferredNumericFloat == 3.5)
assert(inferredNegativeFloat == 1.5)
assert(inferredNamedFloat == 1.5)
assert(inferredOptionalFloat.unwrap() == 1.0)
assert(inferredArrayFloat[1] == 2.0)
assert(methodOptionalFloat.unwrap() == 1.0)
assert(staticArrayFloat[1] == 2.0)
assert(Values.same("a", "a"))
assert(Values.same<Int64?>(Optional.some(1), Optional.some(1)))
assert(Values.same<Values.Phase>(Values.Phase.active, Values.Phase.active))
assert(scalarBox.get() == "text")
assert(constrainedMethod == 61)
assert(vectorDouble.x == 4)
assert(1 < 2)
assert(Values.first([20, 21]) == 20)
assert(Values.keep(left: 11, right: 2.0) == 11)
assert(Values.choose(left: 5, right: 6) == 5)
assert(Values.repeat(17, 3) == 17)
