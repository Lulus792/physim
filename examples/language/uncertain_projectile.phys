// Same uncertain vacuum projectile and sensor streams as examples/uncertain_projectile/main.c.
let gravity = 9.80665
let metres = Unit(1, 0, 0, 0, 0, 0, 0, 1, "m")
let speed = Unit(1, 0, -1, 0, 0, 0, 0, 1, "m/s")
let seconds = Unit(0, 0, 1, 0, 0, 0, 0, 1, "s")
let one = Unit(0, 0, 0, 0, 0, 0, 0, 1, "1")
let joules = Unit(2, 1, -2, 0, 0, 0, 0, 1, "J")
let config = SensorConfig(unit: metres, rateHz: 100, startTime: 0,
                          resolution: 0.005, offset: 0.01, driftPerSecond: 0.002,
                          noise: Distribution.normal(0, 0.02), dropoutProbability: 0.05,
                          uncertaintyAbsolute: 0.003, uncertaintyRelative: 0.001)
let cx = Channel("position.x", metres, "Physical x with uncertain initial velocity")
let cy = Channel("position.y", metres, "Physical y with uncertain initial velocity")
let cvx = Channel("velocity.x", speed, "Physical vx")
let cvy = Channel("velocity.y", speed, "Physical vy")
let ce = Channel("energy", joules, "Physical mechanical energy")
let cnx = Channel("nominal.x", metres, "Nominal horizontal position")
let cny = Channel("nominal.y", metres, "Nominal vertical position")
let csx = Channel("sensor.x", metres, "Use only when sensor.x.status is 1")
let csy = Channel("sensor.y", metres, "Use only when sensor.y.status is 1")
let csxs = Channel("sensor.x.status", one, "0:not due, 1:valid, 2:dropped")
let csys = Channel("sensor.y.status", one, "0:not due, 1:valid, 2:dropped")
let cst = Channel("sensor.time", seconds, "Actual sampling call time")
let csxu = Channel("sensor.x.u", metres, "Standard uncertainty of valid x")
let csyu = Channel("sensor.y.u", metres, "Standard uncertainty of valid y")
let css = Channel("sensor.skipped", one, "Skipped scheduled slots")
var sensors = [Sensor(config, 0), Sensor(config, 0)]
var state = Vec4(-2, 0, 3, 5)
var time = 0.0
var timeCorrection = 0.0
var ticks = 0
var trail = [Vec3(-2, 0, 0)]
var lastMeasured: Vec3? = nil

func slope(value: Vec4) -> Vec4:
    return Vec4(value.z, value.w, 0, -gravity)

func measure():
    let x = sensors[0].read(time, Quantity(state.x, metres))
    let y = sensors[1].read(time, Quantity(state.y, metres))
    cx.sample(state.x)
    cy.sample(state.y)
    cvx.sample(state.z)
    cvy.sample(state.w)
    ce.sample(0.5 * (state.z * state.z + state.w * state.w) + gravity * state.y)
    cnx.sample(-2 + 3 * time)
    cny.sample(5 * time - 0.5 * gravity * time * time)
    csx.sample(x.value.value)
    csy.sample(y.value.value)
    csxs.sample(Float64(x.state))
    csys.sample(Float64(y.state))
    cst.sample(time)
    csxu.sample(x.standardUncertainty)
    csyu.sample(y.standardUncertainty)
    css.sample(Float64(x.skipped))
    if x.isValid() && y.isValid():
        lastMeasured = Optional.some(Vec3(x.value.value, y.value.value, 0))

func create():
    metadata("model=uncertain vacuum projectile\nmass_kg=1\ng_m_s2=9.80665\nground=none\nintegrator=RK4\nvx_distribution=normal\nvx_mean_m_s=3\nvx_stddev_m_s=0.15\nvy_distribution=normal\nvy_mean_m_s=5\nvy_stddev_m_s=0.25\nmeasurement_api=1\nsensor_rate_hz=100\nsensor_distribution=normal\nsensor_stddev_m=0.02\nsensor_seed_x=seed XOR 0xa0761d6478bd642f\nsensor_seed_y=seed XOR 0xe7037ed1a0b428db\nsensor_offset_m=0.01\nsensor_drift_m_s=0.002\nsensor_resolution_m=0.005\nsensor_dropout_probability=0.05\nsensor_u_absolute_m=0.003\nsensor_u_relative=0.001\nsensor_status=0:not_due,1:valid,2:dropped; invalid values are zero placeholders")

func reset():
    state = Vec4(-2, 0, randomNormal(3, 0.15), randomNormal(5, 0.25))
    time = 0.0
    timeCorrection = 0.0
    ticks = 0
    trail = [Vec3(-2, 0, 0)]
    lastMeasured = nil
    sensors[0] = Sensor.forRun(config, -6884282663029611473)
    sensors[1] = Sensor.forRun(config, -1800455987208640293)
    measure()

func step(dt: Float64):
    let k1 = slope(state)
    let k2 = slope(state + 0.5 * dt * k1)
    let k3 = slope(state + 0.5 * dt * k2)
    let k4 = slope(state + dt * k3)
    state += dt / 6 * (k1 + 2 * k2 + 2 * k3 + k4)
    let corrected = dt - timeCorrection
    let nextTime = time + corrected
    timeCorrection = (nextTime - time) - corrected
    time = nextTime
    measure()
    ticks += 1
    if ticks % 10 == 0:
        if trail.count == 64:
            trail.remove(at: 0)
        trail.append(Vec3(state.x, state.y, 0))

func scene():
    let actual = Vec3(state.x, state.y, 0)
    let nominal = Vec3(-2 + 3 * time, 5 * time - 0.5 * gravity * time * time, 0)
    sphere(actual, 0.09, 1407107839, 1)
    point(nominal, 0.05, 2006699263, 2)
    if let measured = lastMeasured:
        point(measured, 0.035, 4073026303, 3)
        let horizontal = Vec3(0.18, 0, 0)
        let vertical = Vec3(0, 0.18, 0)
        line(measured - horizontal, measured + horizontal, 0.008, 4073026303, 4)
        line(measured - vertical, measured + vertical, 0.008, 4073026303, 7)
    arrow(actual, actual + Vec3(state.z * 0.12, state.w * 0.12, 0), 0, 1407107839, 5)
    if trail.count > 1:
        polyline(trail, 0.008, 1407107839, 6)
    label(actual, "Zufälliger Anfangszustand", 3807048447, 8)
    label(nominal, "Sollbahn", 2006699263, 9)
