// SI: a homogeneous sphere receives an off-centre impulse.
let zero = Vec3(0, 0, 0)
let identity = Quat(0, 0, 0, 1)
var sphereBody: Body = Body.sphere(mass: 2, radius: 0.5)
assert(sphereBody.mass == 2 && abs(sphereBody.inertia.z - 0.2) < 1e-14)
sphereBody.setState(zero, zero, identity, zero)
let resting = sphereBody
sphereBody.applyImpulse(impulse: Vec3(2, 0, 0), point: Vec3(0, 1, 0))
assert(sphereBody.velocity.x == 1 && abs(sphereBody.angularVelocity.z + 10) < 1e-12)
assert(abs(sphereBody.kineticEnergy() - 11) < 1e-12)
assert(abs(sphereBody.pointVelocity(Vec3(0, 1, 0)).x - 11) < 1e-12)
assert(sphereBody.forceTorque(Vec3(3, 0, 0), Vec3(0, 1, 0)).z == -3)
sphereBody.step(dt: 0.1, torque: zero, force: zero)
assert(abs(sphereBody.position.x - 0.1) < 1e-14)
assert(abs(sphereBody.orientation.z + sin(0.5)) < 1e-12)
assert(abs(sphereBody.orientation.w - cos(0.5)) < 1e-12)
assert(resting.velocity.x == 0 && resting.angularVelocity.z == 0)

struct Bodies:
    var values: [Body]
    mutating func kick():
        self.values[0].applyImpulse(Vec3(2, 0, 0), self.values[0].position)
var group = Bodies([resting])
let original = group
group.kick()
assert(group.values[0].velocity.x == 1 && original.values[0].velocity.x == 0)
group.values.append(Body.box(3, Vec3(2, 4, 6)))
assert(abs(group.values[1].inertia.x - 13) < 1e-12)
var calls = 0
func index() -> Int64:
    calls += 1
    return 0
func impulse() -> Vec3:
    assert(calls == 1)
    calls += 1
    return Vec3(2, 0, 0)
group.values[index()].applyImpulse(impulse: impulse(), point: zero)
assert(calls == 2 && group.values[0].velocity.x == 2)
let copy = group.values
group.values[0].step(zero, zero, 0.2)
assert(group.values[0].position.x == 0.4 && copy[0].position.x == 0)

var fixed = Body.box(0, Vec3(1, 2, 3))
fixed.setState(Vec3(1, 2, 3), zero, identity, zero)
fixed.applyImpulse(Vec3(100, 200, 300), zero)
fixed.step(Vec3(100, 200, 300), Vec3(200, 100, 300), 0.1)
assert(fixed.position.x == 1 && fixed.velocity.length() == 0 && fixed.kineticEnergy() == 0)
print("rigid body checks passed")
