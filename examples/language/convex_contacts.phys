// Uniform regular tetrahedron: centroid at origin, each inertia = 2*m/5.
// Geometry plus one force-free linear sweep event; no resting manifold.
let vertices = [Vec3(1,1,1),Vec3(1,-1,-1),Vec3(-1,1,-1),Vec3(-1,-1,1)]
let indices = [0,1,2,0,3,1,0,2,3,1,3,2]
var body = Body.withInertia(1,Vec3(0.4,0.4,0.4))
var sphere = Body.sphere(1,0.5)
sphere.setState(Vec3(1.2,1.2,1.2),Vec3(0,0,0),Quat(0,0,0,1),Vec3(0,0,0))
let contact = Contacts.sphereConvex(sphere,0.5,body,vertices,indices)
assert(contact.count == 1)
assert(isClose(contact.penetration(0),0.5-sqrt(0.12),1e-12,1e-12))
let bounds = Aabb.convex(body,vertices,indices)
assert(bounds.minimum.x <= -1)
assert(bounds.maximum.x >= 1)
body.setState(Vec3(0,0,0),Vec3(0,0,0),Quat.axisAngle(Vec3(0,0,1),0.4),Vec3(0,0,0))
let plane = Contacts.convexPlane(body,vertices,indices,Vec3(0,0,-0.8),Vec3(0,0,1))
assert(plane.count == 1)
assert(isClose(plane.penetration(0),0.2,1e-12,1e-12))
let wall = Body.withInertia(0,Vec3(0,0,0))
sphere.setState(Vec3(10,1,1),Vec3(-20,0,0),Quat(0,0,0,1),Vec3(0,0,0))
let event = Sweep.sphereConvex(sphere,0.5,Vec3(-20,0,0),wall,vertices,indices,Vec3(0,0,0))
assert(event.hit)
assert(isClose(event.fraction(),0.425,1e-12,1e-12))
sphere.step(Vec3(0,0,0),Vec3(0,0,0),event.fraction())
let response = event.contacts().resolveSingle(sphere,wall,1,0)
sphere = response.bodyA
sphere.step(Vec3(0,0,0),Vec3(0,0,0),1-event.fraction())
assert(isClose(sphere.position.x,13,1e-10,1e-10))
assert(isClose(sphere.kineticEnergy(),200,1e-10,1e-10))
var rotor = Body.withInertia(1,Vec3(0.4,0.4,0.4))
rotor.setState(Vec3(0,1.2,0),Vec3(0,0,0),Quat(0,0,0,1),Vec3(0,0,6.283185307179586))
let spin = RigidMotion(Vec3(0,0,0),Vec3(0,0,6.283185307179586),Vec3(0,0,0))
let turning = Sweep.convexPlaneMotion(rotor,vertices,indices,spin,Vec3(0,0,0),Vec3(0,1,0),CcdSettings.defaults())
assert(turning.hit)
let reference = (asin(1.2/sqrt(2))-0.7853981633974483)/6.283185307179586
assert(isClose(turning.fraction(),reference,1e-7,1e-7))
print("Convex tetrahedron geometry passed")
