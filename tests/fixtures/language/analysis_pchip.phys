func analyze():
    report("Monotone cubic interpolation")
    let seconds = Unit(0,0,1,0,0,0,0,1,"s")
    let metres = Unit(1,0,0,0,0,0,0,1,"m")
    let x = Series.fromValues([0.0,1.0,2.0],seconds,"time")
    let y = x.alignedValues([0.0,1.0,4.0],metres,"square")
    let q = Series.fromValues([0.0,0.5,1.0,1.5,2.0],seconds,"grid")
    let result = y.resampledPchip(x,q)
    let direct = y.resampledPchip(x: x,targetX: q)
    let snapshot = result.values(0,5)
    let expected = [0.0,0.3125,1.0,2.1875,4.0]
    for index in 0..<5:
        assert(abs(snapshot[index] - expected[index]) < 2e-14)
    assert(direct.values(0,5) == result.values(0,5))
    assert(result.exponent(0) == 1 && result.unitScale() == 1)
    let graph = result.plot(q,"PCHIP","monotone cubic")
    let linear = y.resampledLinear(x,q)
    graph.curve(q,linear,"linear")
    y.release()
    x.release()
    assert(result.values(0,5) == snapshot)
    result.release()
    direct.release()
    linear.release()
    q.release()
