let titles = ["Invalid operation reference"]
func analyze():
    let temporary = [titles, titles][0..<1]
    report(temporary[0][0])
    let run = Dataset(0)
    let time = run.series("time")
    let x = run.series("position.x")
    let metres = Unit(1, 0, 0, 0, 0, 0, 0, 1, "m")
    let seconds = Unit(0, 0, 1, 0, 0, 0, 0, 1, "s")
    if inputCount() == 1:
        let invalid = x.integral(time, 0, metres)
    else:
        if inputCount() == 2:
            let other = (Dataset(1)).series("position.x")
            let invalid = x.adding(other)
        else:
            if inputCount() == 3:
                let outside = time.affine(2, 0, seconds)
                let invalid = x.resampledLinear(time, outside)
            else:
                if inputCount() == 4:
                    let zero = x.subtracting(x)
                    let invalid = x.divided(zero)
                else:
                    if inputCount() == 5:
                        let invalid = Int64(9223372036854775808.0)
                    else:
                        if inputCount() == 6:
                            let invalid = x.slice(-1, 1)
                        else:
                            if inputCount() == 7:
                                let invalid = x.slice(4, 2)
                            else:
                                let invalid = run.channelName(1)
