var mode = 0.0
var evaluation = 0
var source: [Vec3] = []
func vertices() -> [Vec3]:
    evaluation = evaluation * 10 + 1
    return source
func tint() -> Int64:
    evaluation = evaluation * 10 + 2
    source[0] = Vec3(99, 99, 99)
    return 4294967295
func identifier() -> Int64:
    evaluation = evaluation * 10 + 3
    return 3
func width() -> Float64:
    evaluation = evaluation * 10 + 4
    return 0.0
func create():
    return
func reset():
    mode = 0.0
    evaluation = 0
    source = []
func step(dt: Float64):
    mode = dt
    if mode == 6:
        point(Vec3(0, 0, 0), 0.1, 0, 1)
    if mode == 7:
        polyline([Vec3(0, 0, 0), Vec3(1, 0, 0)], 0, 0, 2)
func scene():
    let origin = Vec3(0, 0, 0)
    let identity = Quat(0, 0, 0, 1)
    // A later error must clear this partially built scene.
    sphere(origin, 1, 0, 1)
    if mode >= 8:
        var points = [origin, Vec3(1, 0, 0)]
        // Point storage, not just objects, must be cleared after a later failure.
        polyline(points, 0, 0, 2)
        if mode == 8:
            polyline([], 0, 0, 3)
        if mode == 9:
            polyline([origin], 0, 0, 3)
        if mode == 10:
            polyline(points, -0.1, 0, 3)
        if mode == 11:
            polyline(points, 0, 0, 2)
        if mode == 12:
            polyline(points, 0, -1, 3)
        if mode == 13:
            for i in 0..<94:
                points.append(Vec3(Float64(i), 0, 0))
            polyline(points, 0, 0, 3)
        if mode == 14:
            for i in 0..<30:
                point(origin, 0.1, 0, 0)
            polyline(points, 0, 0, 3)
        if mode == 15:
            for i in 0..<92:
                points.append(Vec3(Float64(i), 0, 0))
            source = points
            polyline(points: vertices(), color: tint(), id: identifier(), radius: width())
            assert(evaluation == 1234)
            assert(source[0].x == 99)
            assert(points[0].x == 0)
    if mode == 1:
        box(origin, Vec3(1, 0, 1), identity, 0, 2)
    else:
        if mode == 2:
            plane(origin, Vec2(1, 1), Quat(0, 0, 0, 0), 0, 2)
        else:
            if mode == 3:
                label(origin, "invalid\nlabel", 0, 2)
            else:
                if mode == 4:
                    box(origin, Vec3(1, 1, 1), identity, 0, 1)
                else:
                    if mode == 5:
                        point(origin, 0.1, 4294967296, 2)
