func near(a: Float64, b: Float64) -> Bool:
    return abs(a - b) <= 1e-13

let curve = Bezier3(Vec3(0, 0, 0), Vec3(1 / 3, 0, 0),
                    Vec3(2 / 3, 1 / 3, 0), Vec3(1, 1, 1))
struct Trajectory:
    let path: Bezier3

func moved(value: Trajectory) -> Trajectory:
    return value

let saved = moved(Trajectory(curve)).path
for index in 0...100:
    let t = Float64(index) / 100
    let position = saved.position(t)
    let tangent = saved.tangent(t)
    assert(near(position.x, t) && near(position.y, t * t) && near(position.z, t * t * t))
    assert(near(tangent.x, 1) && near(tangent.y, 2 * t) && near(tangent.z, 3 * t * t))

let left = curve.splitLeft(0.4)
let right = curve.splitRight(0.4)
for index in 0...10:
    let u = Float64(index) / 10
    let originalLeft = curve.position(0.4 * u)
    let originalRight = curve.position(0.4 + 0.6 * u)
    let pointLeft = left.position(u)
    let pointRight = right.position(u)
    assert(near(pointLeft.x, originalLeft.x) && near(pointLeft.y, originalLeft.y))
    assert(near(pointLeft.z, originalLeft.z))
    assert(near(pointRight.x, originalRight.x) && near(pointRight.y, originalRight.y))
    assert(near(pointRight.z, originalRight.z))
    let derivative = left.tangent(u)
    let originalDerivative = curve.tangent(0.4 * u)
    assert(near(derivative.x, 0.4 * originalDerivative.x))
    assert(near(derivative.y, 0.4 * originalDerivative.y))
    assert(near(derivative.z, 0.4 * originalDerivative.z))
