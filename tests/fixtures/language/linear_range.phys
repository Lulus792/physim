// Identical binary inputs; dictionary encoding avoids repeating large literal matrices.
func decode(table: [Float64], pattern: String) -> [Float64]:
    let alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    var values: [Float64] = []
    for symbol in pattern:
        for index in 0..<table.count:
            if alphabet[index] == symbol:
                values.append(table[index])
                break
    assert(values.count == pattern.count)
    return values
let result0 = attempt(linearSolve(decode([(1 * pow(2,1))],"0"),[(1.5 * pow(2,-1014))],0))
if let values = result0:
    print("ok")
    for value in values:
        print(value)
else:
    print("error")
