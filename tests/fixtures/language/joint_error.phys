let zero = Vec3(0,0,0)
let a = Body.sphere(1,1)
let fixed = Body.sphere(0,1)
func create():
    return
func reset():
    return
func step(dt: Float64):
    if dt == 1:
        let invalid = DistanceJoint(zero,zero,0,0.2)
    else if dt == 2:
        let invalid = DistanceJoint(zero,zero,1,-0.1)
    else if dt == 3:
        let invalid = DistanceJoint(zero,zero,1,1.1)
    else if dt == 4:
        let invalid = DistanceJoint(zero,zero,1,0.2).resolve(a,fixed,0.01)
    else if dt == 5:
        let invalid = DistanceJoint(zero,Vec3(1,0,0),1,0.2).resolve(a,fixed,0)
    else if dt == 6:
        let invalid = DistanceJoint(Vec3(1e308,0,0),Vec3(-1e308,0,0),1,0.2).resolve(a,fixed,0.01)
    else:
        let invalid = DistanceJoint(zero,Vec3(1,0,0),1,0.2).resolve(a,fixed,-1)
func scene():
    return
