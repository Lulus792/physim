var sources = 0
var guards = 0

func source() -> Int64:
    sources += 1
    return -2

func accepts() -> Bool:
    guards += 1
    return false

func classify(value: Int64) -> String:
    switch value:
        case -0x8000000000000000:
            return "min"
        case -5...-3:
            return "low negative"
        case -2, -1 if accepts():
            return "guarded"
        case -2, -1:
            return "negative"
        case 0, +1:
            return "small"
        case 2...4:
            return "low range"
        case 5..<8:
            return "high range"
        case 9...9:
            return "single range"
        case 0x7FFFFFFFFFFFFFFF:
            return "max"
        default:
            return "other"

func bit(value: Bool) -> Int64:
    switch value:
        case true:
            return 1
        case false:
            return 0

func guardedBit(value: Bool) -> Int64:
    switch value:
        case true if accepts():
            return 9
        case true:
            return 1
        case false:
            return 0

func textCode(value: String) -> Int64:
    switch value:
        case "", "ok":
            return 1
        case "line\nnext" if accepts():
            return 2
        case "line\nnext":
            return 3
        default:
            return 4

assert(classify(source()) == "negative")
assert(sources == 1 && guards == 1)
assert(classify(0) == "small" && classify(1) == "small")
assert(classify(-5) == "low negative" && classify(-3) == "low negative")
assert(classify(2) == "low range" && classify(4) == "low range")
assert(classify(5) == "high range" && classify(7) == "high range")
assert(classify(9) == "single range")
assert(classify(-9223372036854775808) == "min")
assert(classify(9223372036854775807) == "max")
assert(classify(8) == "other" && guards == 1)
assert(bit(true) == 1 && bit(false) == 0)
assert(guardedBit(true) == 1 && guardedBit(false) == 0)
assert(guards == 2)
assert(textCode("") == 1 && textCode("ok") == 1)
assert(textCode("line\nnext") == 3 && textCode("other") == 4)
assert(guards == 3)

func guardedRange(value: Int64) -> Int64:
    switch value:
        case 1...3 if accepts():
            return 9
        case 1...3:
            return 1
        default:
            return 0

assert(guardedRange(2) == 1 && guards == 4)
assert(guardedRange(4) == 0 && guards == 4)

func edgeRange(value: Int64) -> Int64:
    switch value:
        case -0x8000000000000000...-0x7FFFFFFFFFFFFFFF:
            return 1
        case 0x7FFFFFFFFFFFFFFE...0x7FFFFFFFFFFFFFFF:
            return 2
        default:
            return 0

assert(edgeRange(-9223372036854775808) == 1)
assert(edgeRange(9223372036854775807) == 2)
assert(edgeRange(0) == 0)

var floatSources = 0

func floatSource() -> Float64:
    floatSources += 1
    return 1.5

func classifyFloat(value: Float64) -> String:
    switch value:
        case -0.0:
            return "zero"
        case 1.5, +2.5:
            return "small"
        case 3:
            return "three"
        case 1e2:
            return "hundred"
        default:
            return "other"

assert(classifyFloat(floatSource()) == "small" && floatSources == 1)
assert(classifyFloat(0.0) == "zero")
assert(classifyFloat(2.5) == "small")
assert(classifyFloat(3.0) == "three")
assert(classifyFloat(100.0) == "hundred")
assert(classifyFloat(4.0) == "other")

func guardedFloat(value: Float64) -> Int64:
    switch value:
        case 1.5 if accepts():
            return 9
        case 1.5:
            return 1
        default:
            return 0

assert(guardedFloat(1.5) == 1 && guards == 5)
assert(guardedFloat(4.0) == 0 && guards == 5)

func classifyFloatRange(value: Float64) -> String:
    switch value:
        case -2.5..<0.0:
            return "negative"
        case 0.0..<1.0:
            return "fraction"
        case 1.0...1.0:
            return "one"
        case 2...3:
            return "two to three"
        default:
            return "other"

assert(classifyFloatRange(-2.5) == "negative")
assert(classifyFloatRange(-0.0) == "fraction")
assert(classifyFloatRange(0.5) == "fraction")
assert(classifyFloatRange(1.0) == "one")
assert(classifyFloatRange(2.0) == "two to three")
assert(classifyFloatRange(3.0) == "two to three")
assert(classifyFloatRange(3.5) == "other")

func guardedFloatRange(value: Float64) -> Int64:
    switch value:
        case 1.0..<2.0 if accepts():
            return 9
        case 1.5...2.5:
            return 1
        default:
            return 0

assert(guardedFloatRange(1.5) == 1 && guards == 6)
assert(guardedFloatRange(2.5) == 1 && guards == 6)
assert(guardedFloatRange(3.0) == 0 && guards == 6)
