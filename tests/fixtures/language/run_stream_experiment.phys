let metres = Unit(1,0,0,0,0,0,0,1,"m")
let output = Channel("replayed",metres,"Position read from an opaque cursor")
let store = RunStore()
var reader = store.openReader("stream α.psrun")
func create():
    metadata("model=opaque stream replay\nsource=stream α.psrun")
    store.configure(0.125,42,"writer_source=experiment")
    let joule = Unit(2,1,-2,0,0,0,0,1,"J")
    assert(store.addChannel("position.x",metres,"Measured x α") == 0)
    assert(store.addChannel("energy",joule,"Energy") == 1)
    let writer = store.createWriter("experiment-stream-copy.psrun","Experiment stream copy")
    while reader.next():
        let row = reader.row()
        writer.append(row.time(0),[row.value(0,0),row.value(0,1)])
    writer.close()
func reset():
    reader.close()
    reader = store.openReader("stream α.psrun")
    output.sample(0)
func step(dt: Float64):
    assert(reader.next(),"Expected one complete recorded row")
    output.sample(reader.row().value(0,0))
func scene():
    return
