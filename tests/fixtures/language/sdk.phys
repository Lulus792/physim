var v = Vec3(z: 3, x: 1, y: 2)
v.y = 4
assert(v.x == 1.0 && v.y == 4.0 && v.z == 3.0)
let a = Vec2(1, 2)
let next = a.symplectic(dt: 0.5, acceleration: -2)
assert(a.x == 1.0 && a.y == 2.0)
assert(next.x == 1.5 && next.y == 1.0)
assert(1 + Vec2(2, 3).x == 3.0)
assert(1 + sin(0) == 1.0)
assert(cos(0) == 1.0 && abs(-3) == 3.0 && sqrt(4) == 2.0)
assert(abs(tan(0.5) - sin(0.5) / cos(0.5)) < 1e-15)
assert(asin(0) == 0 && acos(1) == 0 && atan(0) == 0)
assert(abs(atan2(y: 1, x: 0) - 1.5707963267948966) < 1e-15)
assert(exp(0) == 1 && log(1) == 0 && log10(100) == 2)
assert(pow(base: 2, exponent: 3) == 8 && hypot(3, 4) == 5)
assert(floor(-1.2) == -2 && ceil(-1.2) == -1)
assert(round(1.5) == 2 && round(-1.5) == -2)
let metre = Unit(1, 0, 0, 0, 0, 0, 0, 1, "m")
let centimetre = Unit(1, 0, 0, 0, 0, 0, 0, 0.01, "cm")
assert(centimetre.convert(to: metre, value: 200) == 2.0)
print("sdk checks passed")
// All four components participate; quaternion storage is a distinct type.
let four = Vec4(w: 4, z: 3, y: 2, x: 1)
assert(four == Vec4(1, 2, 3, 4) && four != Vec4(1, 2, 3, 5))
assert(+four - -four == four * 2 && 2 * four / 4 == four / 2)
assert(four.dot(Vec4(4, 3, 2, 1)) == 20.0)
assert((Vec4(1, 2, 2, 4)).length() == 5.0)
assert((Vec4(0, 0, 0, 0)).normalized() == Vec4(0, 0, 0, 0))
assert((Vec4(1e308, 1e308, 1e308, 1e308)).normalized() == Vec4(0.5, 0.5, 0.5, 0.5))
assert((Vec4(0, 0, 0, 1e-308)).normalized() == Vec4(0, 0, 0, 1))
assert(Vec4(1e-308, 0, -1e-308, 1e-308) / 1e-308 == Vec4(1, 0, -1, 1))
struct FourState:
    var value: Vec4
var fourState = FourState(four)
let fourCopy = fourState
fourState.value.w += 2
fourState.value += four
fourState.value *= 2
assert(fourCopy.value.w == 4.0 && fourState.value == Vec4(4, 8, 12, 20))
var fourVisits = 0
func fourOperand() -> Vec4:
    fourVisits += 1
    return Vec4(0, 0, 0, Float64(fourVisits))
assert(fourOperand() - fourOperand() == Vec4(0, 0, 0, -1))
assert(fourVisits == 2)
struct Pose:
    var rotation: Quat
var pose = Pose(Quat(x: 0, y: 0, z: 0, w: 2))
let original = pose
pose.rotation.w = 3
assert(original.rotation.w == 2.0 && pose.rotation.w == 3.0)
assert(1 + pose.rotation.w == 4.0)
let identity = pose.rotation.rotate(Vec3(1, 2, 3))
assert(identity.x == 1.0 && identity.y == 2.0 && identity.z == 3.0)
let turn = Quat.axisAngle(axis: Vec3(0, 0, 10), angle: 1.5707963267948966)
let rotated = turn.rotate(vector: Vec3(1, 0, 0))
assert(abs(rotated.x) < 1e-12 && abs(rotated.y - 1) < 1e-12)
assert(Quat.axisAngle(Vec3(0, 0, 0), 1).w == 1.0)
let qi = Quat(1, 0, 0, 0)
let qj = Quat(0, 1, 0, 0)
assert(qi.multiplied(qj).z == 1.0 && qj.multiplied(qi).z == -1.0)
assert(qi.multiplied(qi).w == -1.0)
let rawConjugate = (Quat(1, -2, 3, 4)).conjugated()
assert(rawConjugate.x == -1.0 && rawConjugate.y == 2.0 && rawConjugate.z == -3.0 && rawConjugate.w == 4.0)
assert((Quat(0, 0, 0, 2)).multiplied(Quat(0, 0, 0, 3)).w == 6.0)
assert((Quat(0, 0, 0, 0)).multiplied(qi).w == 0.0)
assert((Quat(0, 0, 0, 1e-308)).normalized().w == 1.0)
let largeRotation = (Quat(1e308, 1e308, 1e308, 1e308)).normalized()
assert(largeRotation.x == 0.5 && largeRotation.y == 0.5 && largeRotation.z == 0.5 && largeRotation.w == 0.5)
let localTurn = Quat.axisAngle(Vec3(1, 0, 0), 0.7)
let worldTurn = Quat.axisAngle(Vec3(0, 1, 0), -0.9)
let compoundTurn = worldTurn.multiplied(localTurn)
let probeVector = Vec3(1, 2, 3)
assert((compoundTurn.rotate(probeVector) - worldTurn.rotate(localTurn.rotate(probeVector))).length() < 1e-12)
assert(((compoundTurn.conjugated()).rotate(compoundTurn.rotate(probeVector)) - probeVector).length() < 1e-12)
let oppositeSign = Quat(-turn.x, -turn.y, -turn.z, -turn.w)
for index in 0...10:
    let fraction = Float64(index) / 10
    let equivalent = turn.slerp(oppositeSign, fraction)
    assert((equivalent.rotate(probeVector) - turn.rotate(probeVector)).length() < 1e-12)
let tinyTurn = Quat.axisAngle(Vec3(0, 0, 1), 1e-6)
let tinyMid = (Quat(0, 0, 0, 2)).slerp(tinyTurn, 0.5)
assert((tinyMid.rotate(Vec3(1, 0, 0)) - Vec3(cos(5e-7), sin(5e-7), 0)).length() < 1e-12)
let sum = Vec3(1, 2, 3) + Vec3(3, 2, 1)
assert(sum == Vec3(4, 4, 4))
assert(sum - Vec3(1, 1, 1) == Vec3(3, 3, 3))
assert(-sum == Vec3(-4, -4, -4))
assert(+sum == sum && sum != Vec3(4, 4, 5))
assert(2 * sum == sum * 2 && sum / 2 == Vec3(2, 2, 2))
assert(3 * (sum - sum / 2) == Vec3(6, 6, 6))
assert(1 + (sum * 2).x == 9.0)
assert(Vec2(1, 2) + Vec2(3, 4) == Vec2(4, 6))
assert(-Vec2(1, 2) - +Vec2(3, 4) == Vec2(-4, -6))
assert(2 * Vec2(1, 2) / 4 == Vec2(0.5, 1))
assert(Vec2(1, 2) != Vec2(1, 3))
assert((Vec2(1, 2)).dot(Vec2(3, 4)) == 11.0)
assert((Vec3(1, 2, 3)).dot(Vec3(4, 5, 6)) == 32.0)
assert((Vec2(1, 0)).cross(Vec2(0, 1)) == 1.0)
assert((Vec3(1, 0, 0)).cross(Vec3(0, 1, 0)) == Vec3(0, 0, 1))
assert((Vec2(3, 4)).length() == 5.0)
assert((Vec3(2, 3, 6)).length() == 7.0)
assert((Vec2(0, 0)).normalized() == Vec2(0, 0))
assert((Vec3(0, 0, 0)).normalized() == Vec3(0, 0, 0))
assert(abs(((Vec2(1e308, 1e308)).normalized()).length() - 1) < 1e-12)
assert(abs(((Vec3(1e308, 1e308, 1e308)).normalized()).length() - 1) < 1e-12)
// Division must not form a reciprocal that overflows for a tiny divisor.
assert(Vec3(1e-308, 0, -1e-308) / 1e-308 == Vec3(1, 0, -1))
var visits = 0
func operand() -> Vec3:
    visits = visits + 1
    return Vec3(Float64(visits), 0, 0)
assert(operand() - operand() == Vec3(-1, 0, 0))
assert(visits == 2)
let zero = Vec3(0, 0, 0)
assert(springForce(Vec3(2, 0, 0), Vec3(1, 0, 0), zero, zero, 3, 1, 2) == Vec3(-5, 0, 0))
assert(springForce(Vec3(0.5, 0, 0), Vec3(0, 4, 0), zero, zero, 3, 1, 2) == Vec3(1.5, 0, 0))
assert(springForce(zero, zero, zero, zero, 0, 1, 0) == zero)
let drag = stokesDrag(Vec3(3, 4, 0), 1, 0.5)
assert(abs(drag.x + 9 * 3.141592653589793) < 1e-12)
assert(abs(drag.y + 12 * 3.141592653589793) < 1e-12)
let quadratic = quadraticDrag(Vec3(3, 4, 0), 2, 1, 1)
assert(abs(quadratic.x + 15 * 3.141592653589793) < 1e-12)
assert(abs(quadratic.y + 20 * 3.141592653589793) < 1e-12)
assert(quadratic.dot(Vec3(3, 4, 0)) < 0)
assert(stokesDrag(zero, 1, 1) == zero)
assert(quadraticDrag(Vec3(1, 2, 3), 0, 1, 1) == zero)
assert(buoyancyForce(density: 1000, volume: 0.01, gravity: Vec3(0, -10, 0)) == Vec3(0, 100, 0))
