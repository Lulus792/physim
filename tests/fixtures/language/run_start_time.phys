let time = RunStartTime(-1,999999999)
assert(time.isValid() && time.unixSeconds() == -1 && time.nanoseconds() == 999999999)
assert(attempt(RunStartTime(0,-1)) == nil && attempt(RunStartTime(0,1000000000)) == nil)
let values: [RunStartTime] = [time,time]
struct TimeBox:
    let time: RunStartTime
let box = TimeBox(values[0])
let optional: RunStartTime? = Optional.some(box.time)
assert(optional.unwrap().unixSeconds() == -1)
let now = RunStartTime.now()
assert(now.unixSeconds() > 1700000000 && now.nanoseconds() >= 0 && now.nanoseconds() < 1000000000)
let store = RunStore()
store.configure(0.125,42,"")
store.addChannel("value",Unit(1,0,0,0,0,0,0,1,"m"),"")
let writer = store.createWriter("start-language.psrun","start fixture")
writer.append(0,[7.0])
writer.close()
let reader = store.openReader("start-language.psrun")
assert(reader.hasStartTime())
let saved = reader.startTime()
assert(saved.unixSeconds() >= now.unixSeconds() - 1)
assert(RunStartTime.fromMetadata(reader.metadata()).nanoseconds() == saved.nanoseconds())
assert(attempt(RunStartTime.fromMetadata("")) == nil)
reader.close()
store.close()
assert(saved.unixSeconds() > 1700000000)
