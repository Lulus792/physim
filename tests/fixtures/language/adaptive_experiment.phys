let position = Channel("position", Unit(1, 0, 0, 0, 0, 0, 0, 1, "m"), "Oscillator position")
let velocity = Channel("velocity", Unit(1, 0, -1, 0, 0, 0, 0, 1, "m"), "Oscillator velocity reference")
let interval = Channel("interval", Unit(0, 0, 1, 0, 0, 0, 0, 1, "s"), "Accepted interval")
let rejected = Channel("rejected", Unit(0, 0, 0, 0, 0, 0, 0, 1, "1"), "Rejected trial steps")
let endpoint = Channel("endpoint", Unit(0, 0, 1, 0, 0, 0, 0, 1, "s"), "Actual endpoint")
var phase = [1.0, 0.0]
func derivative(time: Float64, state: [Float64]) -> [Float64]:
    return [state[1], -state[0]]
func create():
    metadata("model=harmonic oscillator")
func reset():
    phase = [1.0, 0.0]
    position.sample(1)
    velocity.sample(0)
    interval.sample(0)
    rejected.sample(0)
    endpoint.sample(0)
func step(dt: Float64):
    let time = simulationTime()
    phase = rk4Step(derivative, phase, time, dt)
    position.sample(phase[0])
    velocity.sample(phase[1])
    interval.sample(dt)
    endpoint.sample(time + dt)
func adaptiveStep(dt: Float64, minimum: Float64, maximum: Float64) -> StepInterval:
    let time = simulationTime()
    let result = rk45StepReported(derivative, phase, time, time + dt,
                                  1e-12, 1e-10, 100000, dt, minimum, maximum)
    phase = result.state
    position.sample(phase[0])
    velocity.sample(phase[1])
    interval.sample(result.reachedTime - time)
    rejected.sample(Float64(result.rejectedSteps))
    endpoint.sample(result.reachedTime)
    return StepInterval(result.reachedTime - time, result.nextStep)
func scene():
    sphere(Vec3(phase[0], 0, 0), 0.1, 0xFFFFFFFF, 1)
