assert(Int64.parse("0").unwrap() == 0)
assert(Int64.parse(text: "+0042").unwrap() == 42)
assert(Int64.parse("-9223372036854775808").unwrap() == -9223372036854775808)
assert(Int64.parse("9223372036854775807").unwrap() == 9223372036854775807)
assert(Int64.parse("") == nil)
assert(Int64.parse("+") == nil)
assert(Int64.parse(" 1") == nil)
assert(Int64.parse("1 ") == nil)
assert(Int64.parse("1.0") == nil)
assert(Int64.parse("9223372036854775808") == nil)
assert(Int64.parse("-9223372036854775809") == nil)

assert(Float64.parse(".125").unwrap() == 0.125)
assert(Float64.parse(text: "-1.25e+2").unwrap() == -125.0)
assert(Float64.parse("+0").unwrap() == 0.0)
assert(Float64.parse("") == nil)
assert(Float64.parse(".") == nil)
assert(Float64.parse("1e") == nil)
assert(Float64.parse("1,5") == nil)
assert(Float64.parse("nan") == nil)
assert(Float64.parse("1e309") == nil)

var visits = 0
func nextText() -> String:
    visits += 1
    return "17"

assert(Int64.parse(nextText()).unwrap() == 17)
assert(visits == 1)
assert(Float64.parse(nextText()).unwrap() == 17.0)
assert(visits == 2)

func sum(text: String) -> Int64:
    guard let parsed = Int64.parse(text) else:
        return 0
    return parsed + 1

assert(sum("41") == 42)
assert(sum("bad") == 0)
