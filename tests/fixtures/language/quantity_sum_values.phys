let subtraction = [false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true,false,true]
let metre = Unit(1,0,0,0,0,0,0,1,"m")
for i in 0..<leftValues.count:
    let left = Quantity(leftValues[i],Unit(1,0,0,0,0,0,0,leftScales[i],"a"))
    let right = Quantity(rightValues[i],Unit(1,0,0,0,0,0,0,rightScales[i],"b"))
    let answer = attempt(subtraction[i] ? left - right : left + right)
    if let value = answer:
        assert(value.unit.isCompatible(metre))
        print("ok")
        print(value.value)
        print(value.unit.convert(1,metre))
    else:
        print("numeric")
