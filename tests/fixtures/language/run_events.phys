let store = RunStore()
store.configure(0.125,42,"")
assert(store.addChannel("value",Unit(1,0,0,0,0,0,0,1,"m"),"") == 0)
let writer = store.createWriter("events-language.psrun","events")
func invalidEvent(level: Int64, time: Float64, message: String) -> Bool:
    writer.appendEvent(level,time,message)
    return true
assert(attempt(invalidEvent(0,0,"bad")) == nil)
assert(attempt(invalidEvent(3,0,"")) == nil)
writer.appendEvent(3,0.125,"warning α\nline\t☃")
writer.append(0,[7.0])
writer.appendEvent(4,0.25,"finished")
assert(writer.sampleCount() == 1)
writer.close()
assert(attempt(invalidEvent(3,0,"closed")) == nil)
let reader = store.openReader("events-language.psrun")
assert(attempt(reader.eventMessage()) == nil)
assert(reader.nextEvent() && reader.eventLevel() == 3 && reader.eventTime() == 0.125)
assert(reader.eventMessage() == "warning α\nline\t☃")
assert(attempt(reader.next()) == nil && attempt(reader.nextSnapshot()) == nil)
assert(reader.nextEvent() && reader.eventLevel() == 4 && reader.eventMessage() == "finished")
assert(!reader.nextEvent() && reader.isComplete() && reader.sampleCount() == 1)
assert(reader.eventMessage() == "finished")
reader.close()
store.close()
