// Identity conversions preserve the complete Int64 range.
assert(Int64(9223372036854775807) == 9223372036854775807)
assert(Int64(-9223372036854775808) == -9223372036854775808)
assert(0x7FFFFFFFFFFFFFFF == 9223372036854775807)
assert(-0x8000000000000000 == -9223372036854775808)
assert(0Xff == 255)
let hexFloat: Float64 = 0x10
let negativeHexFloat: Float64 = -0x8000000000000000
assert(hexFloat == 16.0 && negativeHexFloat == -9223372036854775808.0)
assert(0xF + 0.5 == 15.5)
assert(Float64(1.25) == 1.25)
assert(Float64(0) == 0.0)
assert(Int64(-0.0) == 0)
assert(Int64(0.999) == 0)
assert(Int64(-0.999) == 0)
assert(Int64(3.75) == 3)
assert(Int64(-3.75) == -3)
assert(Int64(-9223372036854775808.0) == -9223372036854775808)
assert(Int64(9223372036854774784.0) == 9223372036854774784)
assert(Int64(-9223372036854774784.0) == -9223372036854774784)
assert(Int64("9223372036854775807") == 9223372036854775807)
assert(Int64("-9223372036854775808") == -9223372036854775808)
assert(Float64(".125") == 0.125)
assert(Float64(String(0.1)) == 0.1)
assert(String(42) == "42" && String(true) == "true")

// Integer rounding is nearest, ties to even, including both signs.
assert(Float64(9007199254740991) == 9007199254740991.0)
assert(Float64(9007199254740992) == 9007199254740992.0)
assert(Float64(9007199254740993) == 9007199254740992.0)
assert(Float64(9007199254740995) == 9007199254740996.0)
assert(Float64(-9007199254740993) == -9007199254740992.0)
assert(Float64(-9007199254740995) == -9007199254740996.0)
assert(Float64(18014398509481985) == 18014398509481984.0)
assert(Float64(18014398509481987) == 18014398509481988.0)
assert(Float64(9223372036854775807) == 9223372036854775808.0)
assert(Float64(-9223372036854775808) == -9223372036854775808.0)
var sum = 0.0
for i in 0..<100:
    sum = sum + Float64(i)
    assert(Int64(Float64(i)) == i)
assert(sum == 4950.0)
assert(1 + Float64(2) == 3.0)
assert(Float64(2) + 1 == 3.0)
var evaluations = 0
func count() -> Int64:
    evaluations = evaluations + 1
    return 7
assert(Float64(count()) == 7.0)
assert(evaluations == 1)
print("conversion checks passed")
