func analyze():
    report("Blockwise quantiles")
    let run = Dataset(0)
    assert(run.sampleCount() == 1048577 && run.channelCount() == 2 && !run.recovered())
    assert(run.metadata().contains("seed=17\n"))
    assert(run.channelName(0) == "position.x" && run.channelDescription(0) == "Position α")
    assert(run.channelUnitSymbol(0) == "m" && run.channelExponent(0,0) == 1)
    let position = run.series("position.x")
    let block = position.values(255,258)
    assert(block[0] == 1048321 && block[257] == 1048064)
    let valid = run.series("valid")
    let masked = position.masked(valid,1)
    assert(position.quantile(0.5) == 524288)
    assert(masked.quantile(0.5) == 524288)
    assert(abs(masked.quantile(0.731) - 766509.056) < 1e-9)
    assert(masked.quantile(0) == 0 && masked.quantile(1) == 1048576)
    let histogram = masked.histogram("Valid positions",17)
    run.close()
