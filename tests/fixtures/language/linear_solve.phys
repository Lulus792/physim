let coefficients = [0.0, 2.0, 1.0,
                    1.0, -2.0, -3.0,
                    3.0, -1.0, 2.0]
let rhs = [7.0, -12.0, 7.0]
let result = linearSolve(coefficients, rhs, 0)
assert(result.count == 3)
assert(abs(result[0] - 1) < 1e-12)
assert(abs(result[1] - 2) < 1e-12)
assert(abs(result[2] - 3) < 1e-12)
assert(coefficients[0] == 0 && rhs[0] == 7)

let named = linearSolve(rhs: rhs, pivotTolerance: 0, coefficients: coefficients)
assert(named == result)
let scaled = linearSolve([1e300, 0.0, 0.0, 1e-300], [2e300, 3e-300], 0)
assert(abs(scaled[0] - 2) < 1e-14 && abs(scaled[1] - 3) < 1e-14)

var matrix: [Float64] = []
var target: [Float64] = []
for row in 0..<32:
    for column in 0..<32:
        var entry = 0.0
        if row == column:
            entry = 1.0
        matrix.append(entry)
    target.append(Float64(row) - 16)
let solved = linearSolve(matrix, target, 0)
assert(solved.count == 32)
for index in 0..<32:
    assert(solved[index] == target[index])
