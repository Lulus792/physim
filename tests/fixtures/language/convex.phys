let vertices = [Vec3(-1,-1,-1),Vec3(1,-1,-1),Vec3(1,1,-1),Vec3(-1,1,-1),Vec3(-1,-1,1),Vec3(1,-1,1),Vec3(1,1,1),Vec3(-1,1,1)]
let indices = [0,2,1,0,3,2,4,5,6,4,6,7,0,1,5,0,5,4,3,7,6,3,6,2,0,4,7,0,7,3,1,2,6,1,6,5]
var a = Body.withInertia(1,Vec3(2.0/3,2.0/3,2.0/3))
var b = a
b.setState(Vec3(1.5,0,0),Vec3(0,0,0),Quat(0,0,0,1),Vec3(0,0,0))
let contacts = Contacts.convexes(a,vertices,indices,b,vertices,indices)
assert(contacts.count == 1)
assert(isClose(contacts.penetration(0),0.5,1e-12,1e-12))
assert(isClose(contacts.normal(0).x,1,1e-12,1e-12))
let bounds = Aabb.convex(a,vertices,indices)
assert(bounds.minimum.x <= -1)
assert(bounds.maximum.x >= 1)
let plane = Contacts.convexPlane(a,vertices,indices,Vec3(0,-0.5,0),Vec3(0,1,0))
assert(plane.count == 1)
assert(isClose(plane.penetration(0),0.5,1e-12,1e-12))
var sphere = Body.sphere(1,0.5)
sphere.setState(Vec3(1.4,0,0),Vec3(-1,0,0),Quat(0,0,0,1),Vec3(0,0,0))
let mixed = Contacts.sphereConvex(sphere,0.5,a,vertices,indices)
assert(mixed.count == 1)
assert(isClose(mixed.penetration(0),0.1,1e-12,1e-12))
let response = mixed.resolveSingle(sphere,a,1,0)
assert(isClose(response.bodyA.velocity.x,0,1e-12,1e-12))
assert(isClose(response.bodyB.velocity.x,-1,1e-12,1e-12))
let invalid = attempt(Aabb.convex(a,vertices,[0,1,-1]))
assert(invalid == nil)
print("Convex Physim contacts, bounds, response and trapped invalid mesh passed")
