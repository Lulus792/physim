struct Cell:
    var values: [Float64]
struct State:
    var cells: [Cell]
    let label: String
var state = State([Cell([1, 2]), Cell([])], "state")
let original = state
assert(state.cells.count == 2 && (state.cells[1].values).count == 0)
state.cells[0].values[1] += 5
assert(state.cells[0].values[1] == 7.0)
assert(original.cells[0].values[1] == 2.0)
state.cells[1].values = [3, 4, 5]
state.cells[0] = state.cells[1]
assert(state.cells[0].values[2] == 5.0)
func modify(value: State) -> State:
    var copy = value
    copy.cells[0].values[0] = 99
    return copy
let changed = modify(state)
assert(changed.cells[0].values[0] == 99.0)
assert(state.cells[0].values[0] == 3.0)
func numbers() -> [Int64]:
    return [10, 20, 30]
var a = numbers()
let b = a
a[0] = a[1]
a = a
assert(a[0] == 20 && b[0] == 10)
var visits = 0
func index() -> Int64:
    visits += 1
    return 0
a[index()] += 2
assert(visits == 1 && a[0] == 22)
// An indexed assignment publishes the root snapshot taken before index/RHS calls.
var transactional = [1, 2]
func destination() -> Int64:
    transactional[1] = 88
    return 0
func replacement() -> Int64:
    transactional[1] = 99
    return 5
transactional[destination()] = replacement()
assert(transactional[0] == 5 && transactional[1] == 2)
var total = 0
for i in 0..<1000:
    let temporary = numbers()
    if i % 2 == 0:
        continue
    total += temporary[0]
    if i == 99:
        break
assert(total == 500)
var rounds = 0
while numbers()[0] == 10 && rounds < 1000:
    rounds += 1
    let local = [rounds]
    if rounds < 999:
        continue
    break
assert(rounds == 999)
assert(true || numbers()[99] == 0)
assert(!(false && numbers()[99] == 0))
enum Choice:
    case first
    case second
for i in 0..<10:
    let selector = [Choice.first]
    switch selector[0]:
        case Choice.first:
            let local = numbers()
            if i < 5:
                continue
            break
        default:
            break
struct Node:
    var children: [Node]
    let value: Int64
var root = Node([], 0)
for i in 1...10000:
    root = Node([root], i)
assert(root.children[0].value == 9999)
assert(root.children.count == 1)
print("array checks passed")
var iterable = [1, 2, 3]
var sum = 0
for value in iterable:
    iterable = [99]
    sum += value
assert(sum == 6 && iterable.count == 1)
var evaluations = 0
func rows() -> [[Int64]]:
    evaluations += 1
    return [[1, 2], [], [3, 4]]
sum = 0
for row in rows():
    for value in row:
        if value == 2:
            continue
        sum += value
assert(evaluations == 1 && sum == 8)
func firstCell(cells: [Cell]) -> Cell:
    for cell in cells:
        return cell
    return Cell([])
assert(firstCell(state.cells).values[0] == 3.0)
for attempt in 0..<1000:
    for row in rows():
        let owned = [row, row]
        break
let empty: [Int64] = []
for value in empty:
    assert(false)
let appended = empty + [42]
assert(empty.count == 0 && appended.count == 1 && appended[0] == 42)
var removed = appended
removed.remove(at: 0)
assert(removed.count == 0 && appended[0] == 42)
var edits = [1, 2, 3]
let beforeEdits = edits
edits.remove(at: 1)
assert(edits.count == 2 && edits[0] == 1 && edits[1] == 3)
edits.append(edits[0])
assert(edits[2] == 1 && beforeEdits[1] == 2)
let nested = [[1, 2]]
var grown = nested + [nested[0]]
grown[0][0] = 99
assert(nested[0][0] == 1 && grown[1][0] == 1)
var smaller = grown
smaller.remove(at: 0)
assert(smaller[0][0] == 1 && grown[0][0] == 99)
let cellsAdded = state.cells + [firstCell(state.cells)]
assert(cellsAdded.count == state.cells.count + 1)
var cellsRemoved = cellsAdded
cellsRemoved.remove(at: 0)
assert(cellsRemoved[0].values[0] == cellsAdded[1].values[0])
var argumentOrder = 0
func editSource() -> [Int64]:
    argumentOrder = argumentOrder * 10 + 1
    return [5]
func editValue() -> Int64:
    argumentOrder = argumentOrder * 10 + 2
    return 6
assert((editSource() + [editValue()])[1] == 6)
assert(argumentOrder == 12)
var editedSource = [1, 2]
func replaceSource() -> Int64:
    editedSource = [99]
    return 3
let snapshotAppend = editedSource + [replaceSource()]
assert(snapshotAppend[0] == 1 && snapshotAppend[2] == 3 && editedSource[0] == 99)
let floats = [1.5]
assert(1 + (floats + [2])[0] == 2.5)
for attempt in 0..<1000:
    let a = nested + [[]]
    var b = a
    b.remove(at: 0)
    assert((b[0]).count == 0)
let sliceSource = [10, 20, 30, 40]
var slice = sliceSource[1..<3]
assert(slice.count == 2 && slice[0] == 20 && slice[1] == 30)
slice[0] = 99
assert(sliceSource[1] == 20)
assert(sliceSource[1...2][1] == 30)
assert(sliceSource[0..<4][2..<4][0] == 30)
assert((sliceSource[4..<4]).count == 0)
assert((empty[0..<0]).count == 0)
var slicedCells = cellsAdded[0...0]
slicedCells[0].values[0] = 999
assert(cellsAdded[0].values[0] != 999)
func slicedReturn(values: [[Int64]]) -> [[Int64]]:
    return values[0..<1]
assert(slicedReturn(nested)[0][1] == 2)
var sliceOrder = 0
func sliceInput() -> [Int64]:
    sliceOrder = sliceOrder * 10 + 1
    return [10, 20, 30]
func sliceBegin() -> Int64:
    sliceOrder = sliceOrder * 10 + 2
    return 1
func sliceEnd() -> Int64:
    sliceOrder = sliceOrder * 10 + 3
    return 3
assert(sliceInput()[sliceBegin()..<sliceEnd()][1] == 30)
assert(sliceOrder == 123)
editedSource = [1, 2, 3]
assert(editedSource[0..<replaceSource()][0] == 1)
assert(editedSource[0] == 99)
var sliceSum = 0
for value in sliceSource[1...2]:
    sliceSum += value
assert(sliceSum == 50)
var appendedDirectly: [Int64] = []
appendedDirectly.append(1)
let appendCopy = appendedDirectly
appendedDirectly.append(appendedDirectly[0])
assert(appendedDirectly.count == 2 && appendCopy.count == 1)
var nestedAppend = [[1], [2]]
let beforeAppend = nestedAppend
var appendIndexCalls = 0
func appendIndex() -> Int64:
    appendIndexCalls += 1
    return 0
nestedAppend[appendIndex()].append(3)
assert(appendIndexCalls == 1 && nestedAppend[0][1] == 3 && (beforeAppend[0]).count == 1)
var appendState = Cell([1.0])
let appendStateCopy = appendState
appendState.values.append(2)
assert(appendState.values[1] == 2.0 && appendStateCopy.values.count == 1)
var appendStates = [appendState]
appendStates[0].values.append(3)
assert(appendStates[0].values[2] == 3.0 && appendState.values.count == 2)
editedSource = [1, 2]
editedSource.append(replaceSource())
assert(editedSource.count == 3 && editedSource[0] == 1 && editedSource[2] == 3)
var duringIteration = [1, 2]
for value in duringIteration:
    duringIteration.append(value)
assert(duringIteration.count == 4 && duringIteration[3] == 2)
func appendLocal() -> [[Int64]]:
    var local: [[Int64]] = []
    local.append([7])
    local.append(local[0])
    return local
assert(appendLocal()[1][0] == 7)
let taken = nestedAppend.remove(at: 0)
assert(taken.count == 2 && taken[1] == 3 && nestedAppend.count == 1)
let takenValue = appendState.values.remove(at: 0)
assert(takenValue == 1.0 && appendState.values[0] == 2.0)
let takenCell = appendStates.remove(at: 0)
assert(takenCell.values[2] == 3.0 && appendStates.count == 0)
func removeLocal() -> Cell:
    var local = [Cell([4.0])]
    return local.remove(at: 0)
assert(removeLocal().values[0] == 4.0)
for attempt in 0..<1000:
    var a = [[1], [2]]
    a.append(a[0])
    let first = a.remove(at: 0)
    assert(first[0] == 1 && a[1][0] == 1)
for attempt in 0..<1000:
    let ownedSlice = cellsAdded[0..<cellsAdded.count]
    let nestedSlice = [ownedSlice[0...0]]
    if attempt < 999:
        continue
    break
