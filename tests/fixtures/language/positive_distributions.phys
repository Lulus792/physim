let exponential = Distribution.exponential(2)
assert(exponential.mean() == 2 && exponential.standardDeviation() == 2)
let lognormal = Distribution.logNormal(0.25,0.5)
assert(abs(lognormal.mean()-exp(0.375)) < 1e-14)
let constant = Distribution.logNormal(0,0)
assert(constant.mean() == 1 && constant.standardDeviation() == 0)
var rng = Rng(42)
var copy = rng
let a = rng.sample(exponential)
assert(a > 0 && a == copy.sample(exponential))
let b = rng.sample(lognormal)
assert(b > 0 && b == copy.sample(lognormal))
assert(rng.sample(constant) == 1)
assert(rng.sample(Distribution.uniform(0,1)) == copy.sample(Distribution.uniform(0,1)))
assert(attempt(Distribution.exponential(0)) == nil)
assert(attempt(Distribution.logNormal(0,-1)) == nil)
let bad = Distribution.logNormal(-1000,0)
assert(attempt(bad.mean()) == nil && attempt(rng.sample(bad)) == nil)
print("Positive distribution language values passed")
