let a = [1, 2]
let b = [3, 4]
let combined = a + b
assert(combined.count == 4 && combined[0] == 1 && combined[3] == 4)
assert(a.count == 2 && b.count == 2)
let leftEmpty = [] + a
let rightEmpty = a + []
assert(leftEmpty == a && rightEmpty == a)
let bothEmpty: [Int64] = [] + []
assert(bothEmpty.count == 0)
let floating: [Float64] = [1] + [2.5]
assert(floating.count == 2 && floating[0] == 1.0 && floating[1] == 2.5)
var changed = a
changed += [5]
assert(changed.count == 3 && changed[2] == 5 && a.count == 2)
var doubled = [6, 7]
let beforeDoubling = doubled
doubled += doubled
assert(doubled.count == 4 && doubled[0] == 6 && doubled[2] == 6 && doubled[3] == 7)
assert(beforeDoubling.count == 2 && beforeDoubling[1] == 7)

var nested = [[1], [2, 3]]
let original = nested
let joined = nested + [[4, 5]]
nested[0] += [9]
assert(joined.count == 3 && joined[0].count == 1 && joined[2][1] == 5)
assert(original.count == 2 && original[0].count == 1)
assert(nested[0].count == 2 && nested[0][1] == 9)
nested[1][1..<] += [8]
assert(nested[1].count == 3 && nested[1][1] == 3 && nested[1][2] == 8)

struct Cell:
    var values: [Int64]
var cell = Cell([1])
cell.values += [2, 3]
assert(cell.values.count == 3 && cell.values[2] == 3)

var calls = 0
func left() -> [Int64]:
    calls = calls * 10 + 1
    return [1]
func right() -> [Int64]:
    calls = calls * 10 + 2
    return [2]
assert(left() + right() == [1, 2])
assert(calls == 12)

var span = [1, 2, 3, 4]
var boundsCalls = 0
func lower() -> Int64:
    boundsCalls = boundsCalls * 10 + 1
    return 1
func upper() -> Int64:
    boundsCalls = boundsCalls * 10 + 2
    return 3
func extra() -> [Int64]:
    boundsCalls = boundsCalls * 10 + 3
    return [9]
span[lower()..<upper()] += extra()
assert(boundsCalls == 123 && span.count == 5 && span[1] == 2 && span[3] == 9 && span[4] == 4)
span[0..<0] += [7]
assert(span.count == 6 && span[0] == 7)
