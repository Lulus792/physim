func rootTarget(x: Float64) -> Float64:
    return x * x - 2

func minimumTarget(x: Float64) -> Float64:
    return (x - 3) * (x - 3) + 1

func applyScalar(function: func(Float64) -> Float64, x: Float64) -> Float64:
    return function(x)

func preserve<T>(value: T) -> T:
    return value

var scalarScale: Float64 = 3

struct ScalarOperations:
    let value: Float64
    static func scaled(value: Float64) -> Float64:
        return value * scalarScale

struct OffsetTarget:
    let offset: Float64
    func evaluate(value: Float64) -> Float64:
        return value - self.offset

struct StatefulTarget:
    var evaluations: Int64
    mutating func evaluate(value: Float64) -> Float64:
        self.evaluations += 1
        return value - 1.25

struct HarmonicTarget:
    let frequency: Float64
    func derivative(time: Float64, state: [Float64]) -> [Float64]:
        return [state[1], -self.frequency * self.frequency * state[0]]

func oscillator(time: Float64, state: [Float64]) -> [Float64]:
    return [state[1], -state[0]]

func acceleration(time: Float64, position: [Float64]) -> [Float64]:
    return [-position[0]]

func analyze():
    report("Scalar search reference")
    let selectedRoot: func(Float64) -> Float64 = rootTarget
    let root = rootBisect(selectedRoot, 1, 2, 1e-12, 0, 100)
    let minimum = minimizeGolden(minimumTarget, 0, 6, 1e-8, 0, 100)
    assert(abs(root - 1.4142135623730951) < 1e-11)
    assert(abs(minimum - 3) < 1e-7)
    assert(abs(applyScalar(rootTarget, 2) - 2) < 1e-12)
    assert(abs(applyScalar(ScalarOperations.scaled, 2) - 6) < 1e-12)
    let staticRoot = rootBisect(ScalarOperations.scaled, -1, 1, 1e-12, 0, 100)
    assert(abs(staticRoot) < 1e-11)
    let boundRoot = rootBisect(OffsetTarget(1.25).evaluate, 0, 2, 1e-12, 0, 100)
    assert(abs(boundRoot - 1.25) < 1e-11)
    let stateful: func(Float64) -> Float64 = StatefulTarget(0).evaluate
    let statefulCopy = stateful
    let statefulRoot = rootBisect(stateful, 0, 2, 1e-12, 0, 100)
    assert(abs(statefulRoot - 1.25) < 1e-11)
    assert(abs(statefulCopy(1.25)) < 1e-12)
    let center = 1.375
    let closureTarget = func(x: Float64) -> Float64:
        return x - center
    let closureRoot = rootBisect(closureTarget, 0, 2, 1e-12, 0, 100)
    assert(abs(closureRoot - center) < 1e-11)
    func localTarget(x: Float64) -> Float64:
        return x - center
    let localRoot = rootBisect(localTarget, 0, 2, 1e-12, 0, 100)
    assert(abs(localRoot - center) < 1e-11)
    func localGenericTarget<T: Numeric>(x: T) -> T:
        return x - center
    let localGenericRoot = rootBisect(localGenericTarget<Float64>, 0, 2, 1e-12, 0, 100)
    assert(abs(localGenericRoot - center) < 1e-11)
    let inlineRoot = rootBisect(func(x: Float64) -> Float64:
        return x - center
    , 0, 2, 1e-12, 0, 100)
    assert(abs(inlineRoot - center) < 1e-11)
    assert(abs(applyScalar(preserve<Float64>, 2) - 2) < 1e-12)
    let genericMinimum = minimizeGolden(preserve<Float64>, 0, 6, 1e-8, 0, 100)
    assert(abs(genericMinimum) < 1e-7)
    let rootDetails = rootBisectReported(selectedRoot, 1, 2, 1e-12, 0, 100)
    let minimumDetails = minimizeGoldenReported(minimumTarget, 0, 6, 1e-8, 0, 100)
    assert(abs(rootDetails.x - root) < 1e-11)
    assert(abs(minimumDetails.x - minimum) < 1e-7)
    assert(rootDetails.evaluations > 2)
    assert(minimumDetails.evaluations > 2)
    let selectedOde: func(Float64, [Float64]) -> [Float64] = oscillator
    let next = rk4Step(selectedOde, [1.0, 0.0], 0, 0.1)
    assert(abs(next[0] - cos(0.1)) < 1e-6)
    let boundNext = rk4Step(HarmonicTarget(1).derivative, [1.0, 0.0], 0, 0.1)
    assert(abs(boundNext[0] - cos(0.1)) < 1e-6)
    let frequency = 1.0
    let closureOde = func(time: Float64, state: [Float64]) -> [Float64]:
        return [state[1], -frequency * frequency * state[0]]
    let closureNext = rk4Step(closureOde, [1.0, 0.0], 0, 0.1)
    assert(abs(closureNext[0] - cos(0.1)) < 1e-6)
    let adaptive = rk45Integrate(selectedOde, [1.0, 0.0], 0, 1, 1e-11, 1e-11, 100000)
    assert(abs(adaptive[0] - cos(1)) < 1e-8)
    let configured = rk45IntegrateWithSteps(oscillator, [1.0, 0.0], 0, 1,
                                             1e-11, 1e-11, 100000, 0.1, 1e-14, 0.1)
    assert(abs(configured[0] - cos(1)) < 1e-8)
    let component = rk45IntegrateWithTolerances(oscillator, [1.0, 0.0], 0, 1,
                                                 [1e-11, 1e-11], 1e-11, 100000,
                                                 0.1, 1e-14, 0.1)
    assert(abs(component[0] - cos(1)) < 1e-8)
    let diagnostics = rk45IntegrateReported(oscillator, [1.0, 0.0], 0, 1,
                                            1e-11, 1e-11, 100000, 0.1, 1e-14, 0.1)
    assert(diagnostics.acceptedSteps > 0)
    assert(abs(diagnostics.state[0] - cos(1)) < 1e-8)
    let componentDetails = rk45IntegrateWithTolerancesReported(
        oscillator, [1.0, 0.0], 0, 1, [1e-11, 1e-11], 1e-11, 100000,
        0.1, 1e-14, 0.1)
    assert(abs(componentDetails.state[0] - cos(1)) < 1e-8)
    assert(componentDetails.acceptedSteps > 0)
    let selectedAcceleration: func(Float64, [Float64]) -> [Float64] = acceleration
    let verlet = verletStep(selectedAcceleration, [1.0, 0.0], 0, 0.1)
    assert(abs(verlet[0] - 0.995) < 1e-14)
    assert(abs(verlet[1] + 0.09975) < 1e-14)
