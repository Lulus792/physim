let store = RunStore()
func capacityCheck():
    let owner = RunStore()
    var cursors: [RunReader] = []
    for i in 0..<8:
        cursors.append(owner.openReader("stream α.psrun"))
    assert(attempt(owner.openReader("stream α.psrun")) == nil)
    let removed = cursors.removeLast()
    removed.close()
    let replacement = owner.openReader("stream α.psrun")
    assert(replacement.next() && replacement.row().value(0,0) == 10)
capacityCheck()
func escapedReader() -> RunReader:
    let temporary = RunStore()
    return temporary.openReader("stream α.psrun")
let escaped = escapedReader()
assert(escaped.next() && escaped.row().value(0,0) == 10)
escaped.close()
let storeCopy = store
let reader = store.openReader("stream α.psrun")
let copy = reader
assert(store.isOpen() && reader.isOpen() && reader.channelCount() == 2)
assert(reader.channelName(0) == "position.x" && reader.channelSymbol(0) == "m")
assert(reader.channelDescription(0) == "Measured x α" && reader.channelDimension(0,0) == 1)
assert(reader.metadata().contains("stream fixture"))
assert(attempt(reader.row()) == nil && attempt(reader.snapshot()) == nil)
assert(attempt(reader.channelName(-1)) == nil && attempt(reader.channelDimension(0,7)) == nil)
assert(copy.next())
let row = reader.row()
assert(row.count() == 1 && row.channelCount() == 2 && row.time(0) == 0 && row.value(0,0) == 10)
assert(reader.next() && copy.row().value(0,0) == 12 && row.value(0,0) == 10)
assert(reader.next() && !copy.next() && reader.isComplete() && !reader.isRecovered())
assert(reader.sampleCount() == 3 && reader.statusCode() == 6 && !reader.next())
assert(attempt(reader.nextSnapshot()) == nil)
copy.close()
assert(!reader.isOpen() && attempt(reader.next()) == nil)
let sceneReader = store.openReader("stream α.psrun")
assert(sceneReader.nextSnapshot())
let scene = sceneReader.snapshot()
assert(scene.time() == 0 && scene.objectId(0) == 42)
assert(sceneReader.nextSnapshot() && scene.position(0) == Vec3(0,2,3))
assert(sceneReader.nextSnapshot() && !sceneReader.nextSnapshot() && sceneReader.isComplete())
let partial = store.openReader("partial.psrun")
assert(partial.next() && !partial.next() && partial.isRecovered() && partial.statusCode() == 7)
let damaged = store.openReader("damaged.psrun")
assert(damaged.next() && damaged.next() && !damaged.next())
assert(damaged.isRecovered() && !damaged.isComplete() && damaged.row().value(0,0) == 12)
assert(damaged.sampleCount() == 2 && !damaged.next() && damaged.row().time(0) == 0.125)
struct CursorBox<T>:
    let value: T
let boxes = [CursorBox(sceneReader),CursorBox(partial)]
let retained: RunReader? = Optional.some(boxes[0].value)
storeCopy.close()
assert(!store.isOpen() && !retained.unwrap().isOpen())
assert(row.value(0,0) == 10 && scene.position(0) == Vec3(0,2,3))
assert(attempt(store.openReader("stream α.psrun")) == nil)
print("Language run stream checks passed")
