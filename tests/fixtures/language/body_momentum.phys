var body = Body.withInertia(2,Vec3(3,5,7))
body.setState(Vec3(2,3,4),Vec3(5,6,7),Quat(0,0,0,1),Vec3(1,2,3))
assert(body.linearMomentum() == Vec3(10,12,14))
assert(body.angularMomentum(Vec3(0,0,0)) == Vec3(-3,22,15))
assert(body.angularMomentum(Vec3(1,1,1)) == Vec3(-5,26,13))
let origin = Vec3(-2,1,3)
let before = body.angularMomentum(origin)
body.applyImpulse(Vec3(2,4,-3),Vec3(3,-1,2))
assert(body.linearMomentum() == Vec3(12,16,11))
let change = body.angularMomentum(origin) - before
assert(abs(change.x - 10) < 1e-12 && abs(change.y - 13) < 1e-12 && abs(change.z - 24) < 1e-12)
var extreme = Body.withInertia(pow(2,1023),Vec3(1,1,1))
extreme.setState(Vec3(pow(2,1023),pow(2,1023),0),Vec3(pow(2,1023),pow(2,1023),0),Quat(0,0,0,1),Vec3(0,0,1))
assert(extreme.angularMomentum(Vec3(-pow(2,1023),-pow(2,1023),0)) == Vec3(0,0,1))
assert(attempt(extreme.linearMomentum()) == nil)
extreme.setState(Vec3(pow(2,1023),0,0),Vec3(0,pow(2,1023),0),Quat(0,0,0,1),Vec3(0,0,0))
assert(attempt(extreme.angularMomentum(Vec3(0,0,0))) == nil)
print("Body momentum language checks passed")
