func analyze():
    let run = Dataset(0)
    assert(run.channelCount() == 2 && run.channelName(0) == "time")
    assert(run.channelDescription(0) == "Independent measured clock α")
    let time = run.series("time")
    let clock = run.channelSeries(0)
    let position = run.channelSeries(1)
    assert(time.values(0,3) == [0.0,0.125,0.25])
    assert(clock.values(0,3) == [1000.0,1005.0,1010.0])
    assert(clock.name() == "time" && clock.unitSymbol() == "s" && clock.unitScale() == 1)
    assert(time.isAlignedWith(clock) && position.isAlignedWith(run.series("position.x")))
    assert(attempt(run.channelSeries(-1)) == nil)
    assert(attempt(run.channelSeries(2)) == nil)
    assert(attempt(run.channelSeries(4294967296)) == nil)
    let runtimeRate = position.derivative(time)
    let measuredRate = position.derivative(clock)
    assert(runtimeRate.mean() == 16 && abs(measuredRate.mean() - 0.4) < 1e-15)
    report("Independent recorded clock")
    let plot = measuredRate.plot(clock,"Measured velocity","Measured clock")
    run.close()
    assert(attempt(run.channelSeries(0)) == nil)
