func analyze():
    report("Extreme calculus")
    let seconds = Unit(0,0,1,0,0,0,0,1,"s")
    let metres = Unit(1,0,0,0,0,0,0,1,"m")
    let areaUnit = metres.multiplied(seconds, "m s")
    let axis = Series.fromValues([-1e308, 1e308], seconds, "axis")
    let signal = axis.alignedValues([-1e308, 1e308], metres, "signal")
    let rate = signal.derivative(axis)
    assert(rate.values(0,2) == [1.0,1.0])
    assert(rate.exponent(0) == 1 && rate.exponent(2) == -1)
    let small = axis.alignedValues([1e-308,1e-308], metres,"small")
    let area = small.integral(axis,0,areaUnit)
    assert(area.value(0) == 0 && abs(area.value(1) - 2) < 1e-14)
    assert(area.exponent(0) == 1 && area.exponent(2) == 1)
    let cancel = signal.integral(axis,7,areaUnit)
    assert(cancel.values(0,2) == [7.0,7.0])
    axis.release()
    signal.release()
    assert(rate.values(0,2) == [1.0,1.0] && cancel.value(1) == 7)
