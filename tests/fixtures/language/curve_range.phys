// Independent Fraction references use the exact binary inputs.
func curveCase0():
    let c0 = Bezier3(Vec3(0.0,-0.0,0.0),Vec3((1 * pow(2,-1074)),-(1 * pow(2,-1074)),0.0),Vec3(0.0,-0.0,0.0),Vec3(0.0,-0.0,0.0))
    let p0 = attempt(c0.position(0.0))
    if let value = p0:
        print("ok")
        print(value.x)
        print(value.y)
        print(value.z)
        let tangent = c0.tangent(0.0)
        print(tangent.x)
        print(tangent.y)
        print(tangent.z)
    else:
        print("error")
    let l0 = c0.splitLeft(0.0)
    print(l0.controlPoint(0).x)
    print(l0.controlPoint(0).y)
    print(l0.controlPoint(0).z)
    print(l0.controlPoint(1).x)
    print(l0.controlPoint(1).y)
    print(l0.controlPoint(1).z)
    print(l0.controlPoint(2).x)
    print(l0.controlPoint(2).y)
    print(l0.controlPoint(2).z)
    print(l0.controlPoint(3).x)
    print(l0.controlPoint(3).y)
    print(l0.controlPoint(3).z)
    let r0 = c0.splitRight(0.0)
    print(r0.controlPoint(0).x)
    print(r0.controlPoint(0).y)
    print(r0.controlPoint(0).z)
    print(r0.controlPoint(1).x)
    print(r0.controlPoint(1).y)
    print(r0.controlPoint(1).z)
    print(r0.controlPoint(2).x)
    print(r0.controlPoint(2).y)
    print(r0.controlPoint(2).z)
    print(r0.controlPoint(3).x)
    print(r0.controlPoint(3).y)
    print(r0.controlPoint(3).z)
    if let badLow = attempt(c0.controlPoint(-1)):
        assert(false)
    if let badHigh = attempt(c0.controlPoint(4)):
        assert(false)

