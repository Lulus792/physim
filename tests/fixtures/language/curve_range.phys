    let p70 = attempt(c70.position((1.2828210954176074 * pow(2,-2))))
    if let value = p70:
        print("ok")
        print(value.x)
        print(value.y)
        print(value.z)
        let tangent = c70.tangent((1.2828210954176074 * pow(2,-2)))
        print(tangent.x)
        print(tangent.y)
        print(tangent.z)
    else:
        print("error")
    let l70 = c70.splitLeft((1.2828210954176074 * pow(2,-2)))
    print(l70.controlPoint(0).x)
    print(l70.controlPoint(0).y)
    print(l70.controlPoint(0).z)
    print(l70.controlPoint(1).x)
    print(l70.controlPoint(1).y)
    print(l70.controlPoint(1).z)
    print(l70.controlPoint(2).x)
    print(l70.controlPoint(2).y)
    print(l70.controlPoint(2).z)
    print(l70.controlPoint(3).x)
    print(l70.controlPoint(3).y)
    print(l70.controlPoint(3).z)
    let r70 = c70.splitRight((1.2828210954176074 * pow(2,-2)))
    print(r70.controlPoint(0).x)
    print(r70.controlPoint(0).y)
    print(r70.controlPoint(0).z)
    print(r70.controlPoint(1).x)
    print(r70.controlPoint(1).y)
    print(r70.controlPoint(1).z)
    print(r70.controlPoint(2).x)
    print(r70.controlPoint(2).y)
    print(r70.controlPoint(2).z)
    print(r70.controlPoint(3).x)
    print(r70.controlPoint(3).y)
    print(r70.controlPoint(3).z)

