var sum = 0
for i in 0..<10 by 3:
    sum += i
assert(sum == 18)
for i in 0...9 by 4:
    sum += i
assert(sum == 30)
var descending = 0
for i in 9..<0 by -3:
    descending = descending * 10 + i
assert(descending == 963)
for i in 4...0 by -2:
    descending = descending * 10 + i
assert(descending == 963420)
var wrongDirection = 0
for i in 0...4 by -1:
    wrongDirection += 1
assert(wrongDirection == 0)
for i in 4...0 by 1:
    wrongDirection += 1
assert(wrongDirection == 0)
var descendingControl = 0
for i in 8...0 by -2:
    if i == 6:
        continue
    if i == 0:
        break
    descendingControl += i
assert(descendingControl == 14)
for i in -9223372036854775807...-9223372036854775808 by -2:
    assert(i == -9223372036854775807)
var boundaryVisits = 0
for i in 0...-9223372036854775808 by -9223372036854775808:
    boundaryVisits += 1
assert(boundaryVisits == 2)
0..<5 by 2
5..<0 by -2
var skipped = 0
for i in 0..<10 by 2:
    if i == 2:
        continue
    if i == 8:
        break
    skipped += i
assert(skipped == 10)
for i in 9223372036854775806...9223372036854775807 by 2:
    assert(i == 9223372036854775806)

let by = 2
var count = 0
for i in 0..<7 by by:
    count += 1
assert(count == 4)

var visits = 0
func lower() -> Int64:
    visits += 1
    return 0
func upper() -> Int64:
    visits += 10
    return 4
func stride() -> Int64:
    visits += 100
    return 2
for i in lower()..<upper() by stride():
    count += i
assert(visits == 111 && count == 6)

let source = [0, 1, 2, 3, 4, 5]
assert(source[0..<by].count == 2 && source[..<by].count == 2)
let odds = source[1..<6 by 2]
assert(odds.count == 3 && odds[0] == 1 && odds[1] == 3 && odds[2] == 5)
let evens = source[..< by 2]
assert(evens.count == 3 && evens[0] == 0 && evens[2] == 4)
let closed = source[1...5 by 2]
assert(closed.count == 3 && closed[2] == 5)
let visited = source[lower()..<upper() by stride()]
assert(visits == 222 && visited.count == 2 && visited[0] == 0 && visited[1] == 2)
let empty: [Int64] = []
assert(empty[... by 2].count == 0)

var values = source
values[0..<6 by 2] = [10, 20, 30]
assert(values.count == 6 && values[0] == 10 && values[1] == 1 &&
       values[2] == 20 && values[3] == 3 && values[4] == 30 && values[5] == 5)
assert(source[0] == 0 && source[2] == 2)
values[... by 2] = values[1..<6 by 2]
assert(values.count == 6 && values[0] == 1 && values[2] == 3 && values[4] == 5)
values[lower()..<upper() by stride()] = [7, 8]
assert(visits == 333 && values.count == 6 && values[0] == 7 && values[2] == 8)

var nested = [[1, 2, 3, 4], [5, 6]]
let original = nested
nested[0][0..<4 by 2] = [11, 33]
assert(nested[0].count == 4 && nested[0][0] == 11 && nested[0][1] == 2 &&
       nested[0][2] == 33 && nested[0][3] == 4)
assert(original[0][0] == 1 && original[0][2] == 3)
