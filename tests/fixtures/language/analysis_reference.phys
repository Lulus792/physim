struct Metrics:
    var values: Series
    func mean() -> Float64:
        return self.values.mean()
    mutating func shift(offset: Float64, unit: Unit):
        self.values = self.values.affine(1, offset, unit)
func analyze():
    assert(inputCount() == 1 || inputCount() == 2)
    report("Statistics " + "reference")
    let run = Dataset(0)
    assert(run.sampleCount() == 5)
    assert(run.channelCount() == 1 && !run.recovered())
    let channelName = run.channelName(0)
    let channelUnit = run.channelUnitSymbol(0)
    let channelDescription = run.channelDescription(0)
    assert(channelName == "position.x" && channelUnit == "m")
    assert(channelDescription == "Polynomial reference")
    assert(run.channelExponent(0, 0) == 1)
    for axis in 1..<7:
        assert(run.channelExponent(0, axis) == 0)
    let source = run.metadata()
    assert(source.contains("experiment=C reference"))
    assert(source.contains("seed=0"))
    let time = run.series("time")
    let x = run.series(channelName)
    assert(x.values(1,3) == [0.0625,0.25,0.5625])
    assert(time.values(time.count(),0) == [])
    assert(x.name() == "position.x")
    assert(x.minimum() == 0 && x.maximum() == 1)
    assert(x.quantile(0.5) == 0.25)
    assert(x.unitSymbol() == "m" && x.unitScale() == 1)
    assert(x.exponent(0) == 1 && x.exponent(2) == 0)
    assert(x.isAlignedWith(time))
    let middleTime = time.slice(1, 3)
    let middleX = x.slice(1, 3)
    assert(middleX.minimum() == 0.0625 && middleX.maximum() == 0.5625)
    assert(middleX.isAlignedWith(middleTime))
    assert(!x.isAlignedWith(middleX))
    let middleName = middleX.name()
    assert(middleName == "position.x")
    assert(middleX.count() == 3 && middleX.value(0) == x.value(1))
    assert(middleX.value(2) == x.value(3))
    assert((middleX.adding(middleX)).value(1) == 2 * x.value(2))
    let middleRate = middleX.derivative(middleTime)
    assert(middleRate.count() == 3 && middleRate.unitScale() == 1)
    assert(middleRate.exponent(0) == 1 && middleRate.exponent(2) == -1)
    assert(middleRate.unitSymbol() != "")
    middleRate.release()
    middleX.release()
    middleTime.release()
    assert(middleName == "position.x")
    let empty = x.slice(x.count(), 0)
    assert(empty.count() == 0)
    empty.release()
    assert(time.count() == 5)
    assert(abs(Metrics(x).mean() - 0.375) < 1e-12)
    var total = 0.0
    for index in 0..<x.count():
        total = total + x.value(index)
    assert(abs(total / Float64(x.count()) - x.mean()) < 1e-12)
    assert(Int64(Float64(x.count())) == x.count())
    assert(abs(time.stddev() - sqrt(0.15625)) < 1e-12)
    assert(x.value(4) == 1)
    let average = x.movingAverage(2)
    assert(average.value(0) == 0)
    assert(average.value(4) == 0.78125)
    assert(average.values(3,2) == [0.40625,0.78125])
    assert(average.quantile(0.75) == 0.40625)
    let metres = Unit(1, 0, 0, 0, 0, 0, 0, 1, "m" + "")
    let wide = Series.fromValues([-1e308, 1e308], metres, "wide")
    assert(wide.minimum() == -1e308 && wide.maximum() == 1e308)
    assert(wide.quantile(0.5) == 0)
    wide.release()
    let centimetres = Unit(1, 0, 0, 0, 0, 0, 0, 0.01, "cm")
    let standalone = Series.fromValues([1.0, 2.0, 3.0], centimetres, "standalone")
    assert(standalone.unitScale() == 0.01 && standalone.exponent(0) == 1)
    assert(!standalone.isAlignedWith(x))
    let tail = standalone.slice(1, 2)
    standalone.release()
    assert(tail.name() == "standalone" && tail.value(0) == 2 && tail.value(1) == 3)
    tail.release()
    let sensorConfig = SensorConfig(metres, 4, 0, 0, 0, 0, Distribution.constant(0), 0, 0, 0)
    var sensor = Sensor(sensorConfig, 42)
    for i in 0..<time.count():
        let sample = sensor.read(time.value(i), Quantity(x.value(i), metres))
        assert(sample.isValid() && sample.value.value == x.value(i) && sample.index == i)
    var shiftedMetrics = Metrics(x)
    shiftedMetrics.shift(1, metres)
    assert(abs(shiftedMetrics.mean() - 1.375) < 1e-12 && abs(x.mean() - 0.375) < 1e-12)
    shiftedMetrics.values.release()
    let seconds = Unit(0, 0, 1, 0, 0, 0, 0, 1, "s")
    let metreSeconds = metres.multiplied(seconds, "m" + " s")
    let initialArea = Quantity(2, metreSeconds)
    let area = x.integral(time, initialArea.value, initialArea.unit)
    assert(area.value(0) == 2)
    assert(area.value(4) == 2.34375)
    let shifted = x.affine(factor: 2, offset: 1, unit: metres)
    assert(shifted.value(4) == 3)
    assert((x.adding(x)).value(4) == 2)
    assert((shifted.subtracting(x)).value(4) == 2)
    assert((x.multiplied(shifted)).value(4) == 3)
    assert((x.divided(shifted)).value(4) == 1.0 / 3.0)
    let halfTime = time.affine(0.5, 0, seconds)
    let linear = x.resampledLinear(time, halfTime)
    let nearest = x.resampledNearest(time, halfTime)
    let previous = x.resampledPrevious(time, halfTime)
    assert(linear.value(1) == 0.03125)
    assert(nearest.value(1) == 0)
    assert(previous.value(1) == 0)
    assert(linear.value(4) == 0.25)
    let shiftedTime = time.affine(0.75, 0, seconds)
    assert((x.resampledNearest(time, shiftedTime)).value(1) == 0.0625)
    assert((x.resampledPrevious(time, shiftedTime)).value(1) == 0)
    let graph = x.plot(time, "Pos" + "ition", "raw")
    graph.curve(time, average, "averaged")
    let distribution = x.histogram("Distribution", 4)
    distribution.export("distribution")
    run.close()
    assert(source.contains("seed=0"))
    assert(channelName == "position.x" && channelDescription == "Polynomial reference")
    let reopened = Dataset(0)
    assert((reopened.series("time")).count() == 5)
    if inputCount() == 2:
        let other = Dataset(1)
        let target = other.series("time")
        let copied = (reopened.series("position.x")).resampledLinear(reopened.series("time"), target)
        reopened.close()
        assert(copied.value(4) == 1)
        let combined = copied.adding(other.series("position.x"))
        assert(combined.value(4) == 1)
