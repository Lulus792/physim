var values = [10, 30]
let original = values
values.insert(20, at: 1)
assert(values.count == 3 && values[0] == 10 && values[1] == 20 && values[2] == 30)
assert(original.count == 2 && original[1] == 30)
values.insert(5, at: 0)
values.insert(40, at: values.count)
assert(values.count == 5 && values[0] == 5 && values[4] == 40)
var expanded = values
expanded.insert(25, at: 3)
assert(expanded.count == 6 && expanded[3] == 25 && values.count == 5 && values[3] == 30)

var empty: [Int64] = []
empty.insert(7, at: 0)
assert(empty.count == 1 && empty[0] == 7)

var nested = [[1], [3]]
let old_nested = nested
nested.insert([2], at: 1)
assert(nested.count == 3 && nested[1][0] == 2 && old_nested.count == 2)
nested[1].insert(8, at: 1)
assert(nested[1].count == 2 && nested[1][1] == 8 && old_nested[1][0] == 3)
var copied = nested
copied.insert([9, 10], at: 3)
assert(copied.count == 4 && copied[3][1] == 10 && nested.count == 3)

struct Holder:
    var rows: [[Int64]]
var holder = Holder([[1, 3]])
holder.rows[0].insert(2, at: 1)
assert(holder.rows[0].count == 3 && holder.rows[0][1] == 2)

var visits = 0
func value() -> Int64:
    visits += 1
    return 99
func position() -> Int64:
    visits += 10
    return 1
values.insert(value(), at: position())
assert(visits == 11 && values[1] == 99)

var alias = [1, 2, 3]
alias.insert(alias[0], at: 1)
assert(alias.count == 4 && alias[0] == 1 && alias[1] == 1 && alias[2] == 2)
