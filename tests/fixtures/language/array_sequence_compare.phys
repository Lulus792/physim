let values = [1, 2, 3]
let empty: [Int64] = []
assert(values.starts(with: []))
assert(values.starts(with: [1]))
assert(values.starts(with: [1, 2, 3]))
assert(!values.starts(with: [1, 3]))
assert(!values.starts(with: [1, 2, 3, 4]))
assert(empty.starts(with: []))
assert(!empty.starts(with: [1]))
assert(values.elementsEqual([1, 2, 3]))
assert(!values.elementsEqual([1, 2]))
assert(!values.elementsEqual([1, 2, 4]))
assert(empty.elementsEqual([]))
assert(!empty.elementsEqual([1]))

let nested = [[1], [2]]
assert(nested.starts(with: [[1]]))
assert(nested.elementsEqual([[1], [2]]))
assert(!nested.elementsEqual([[1], [3]]))
assert(["a", "b"].starts(with: ["a"]))
assert(["a", "b"].elementsEqual(["a", "b"]))
assert([0.0].elementsEqual([-0.0]))

struct Mark:
    let value: Int64
let marks = [Mark(1), Mark(2)]
assert(marks.starts(with: [Mark(1)]))
assert(marks.elementsEqual([Mark(1), Mark(2)]))
assert(!marks.elementsEqual([Mark(2), Mark(1)]))

struct Named:
    func starts(with: Int64) -> Bool:
        return with == 1
    func elementsEqual(other: Int64) -> Bool:
        return other == 2
let named = Named()
assert(named.starts(with: 1))
assert(named.elementsEqual(other: 2))

var order = 0
func source() -> [Int64]:
    order = order * 10 + 1
    return [1, 2]
func candidate() -> [Int64]:
    order = order * 10 + 2
    return [1]
assert(source().starts(with: candidate()))
assert(order == 12)
order = 0
assert(!source().elementsEqual(candidate()))
assert(order == 12)
