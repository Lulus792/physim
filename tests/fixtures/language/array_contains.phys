let empty: [Int64] = []
assert(!empty.contains(0))
assert(empty.firstIndex(of: 0) == nil)
assert(empty.lastIndex(of: 0) == nil)
let numbers = [1, 2, 3]
assert(numbers.contains(1) && numbers.contains(3) && !numbers.contains(4))
let middle: Int64? = numbers.firstIndex(of: 2)
assert(middle.hasValue && middle.unwrap() == 1)
assert(numbers.firstIndex(of: 4) == nil)
assert(numbers.lastIndex(of: 4) == nil)
assert([7, 7, 8].firstIndex(of: 7).unwrap() == 0)
assert([7, 7, 8, 7].lastIndex(of: 7).unwrap() == 3)
assert(numbers.lastIndex(of: 2).unwrap() == 1)
assert(numbers.count == 3)
let words = ["first", "second"]
assert(words.contains("second") && !words.contains("other"))
let floating = [1.0, 2.5]
assert(floating.contains(2.5) && !floating.contains(2.0))

let rows = [[1, 2], [3]]
assert(rows.contains([1, 2]) && !rows.contains([2, 1]))
assert(rows.firstIndex(of: [3]).unwrap() == 1)
assert([[3], [1], [3]].lastIndex(of: [3]).unwrap() == 2)
let copies = rows
assert(copies.contains([3]) && rows[0].count == 2)

struct Entry:
    let name: String
    let tags: [Int64]
let entries = [Entry("a", [1, 2]), Entry("b", [])]
assert(entries.contains(Entry("a", [1, 2])))
assert(entries.firstIndex(of: Entry("b", [])).unwrap() == 1)
assert([Entry("b", []), Entry("a", [1, 2]), Entry("b", [])].lastIndex(of: Entry("b", [])).unwrap() == 2)
assert(!entries.contains(Entry("a", [2, 1])))

enum Reading:
    case missing
    case sample(value: Int64, valid: Bool)
let readings = [Reading.missing, Reading.sample(3, true)]
assert(readings.contains(Reading.sample(3, true)))
assert(readings.firstIndex(of: Reading.sample(3, true)).unwrap() == 1)
assert(!readings.contains(Reading.sample(3, false)))

let optionals: [Int64?] = [nil, Optional.some(7)]
assert(optionals.contains(nil) && optionals.contains(Optional.some(7)))
assert(optionals.firstIndex(of: nil).unwrap() == 0)
assert([Optional.some(7), nil, nil].lastIndex(of: nil).unwrap() == 2)
assert(!optionals.contains(Optional.some(8)))

var visits = 0
func source() -> [Int64]:
    visits = visits * 10 + 1
    return [4, 5]
func needle() -> Int64:
    visits = visits * 10 + 2
    return 5
assert(source().contains(needle()))
assert(visits == 12)
visits = 0
assert(source().firstIndex(of: needle()).unwrap() == 1)
assert(visits == 12)
visits = 0
assert(source().lastIndex(of: needle()).unwrap() == 1)
assert(visits == 12)

var changing = [1]
func changeAndFind() -> Int64:
    changing.append(2)
    return 2
assert(changing.firstIndex(of: changeAndFind()) == nil)
assert(changing.count == 2 && changing[1] == 2)
changing = [1]
assert(changing.lastIndex(of: changeAndFind()) == nil)
assert(changing.count == 2 && changing[1] == 2)
assert(!changing.contains(3))

var foundCount = 0
for attempt in 0..<1000000:
    if let index = numbers.firstIndex(of: 3):
        foundCount += index
assert(foundCount == 2000000)
