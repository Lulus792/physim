func oscillator(time: Float64, position: [Float64]) -> [Float64]:
    return [-position[0]]

func still(time: Float64, position: [Float64]) -> [Float64]:
    var acceleration: [Float64] = []
    for value in position:
        acceleration.append(0.0)
    return acceleration

func ramp(time: Float64, position: [Float64]) -> [Float64]:
    return [time]

let initial = [1.0, 0.0]
var phase = initial
for step in 0..<1000:
    phase = verletStep(oscillator, phase, Float64(step) * 0.01, 0.01)
assert(abs(phase[0] - cos(10)) < 5e-5)
assert(abs(phase[1] + sin(10)) < 5e-5)
assert(initial == [1.0, 0.0])
for step in 0..<1000:
    phase = verletStep(oscillator, phase, Float64(1000 - step) * 0.01, -0.01)
assert(abs(phase[0] - 1) < 1e-12)
assert(abs(phase[1]) < 1e-12)

let paired = verletStep(still, [1.0, 2.0, 3.0, 4.0], 0, 0.1)
assert(abs(paired[0] - 1.3) < 1e-14)
assert(abs(paired[1] - 2.4) < 1e-14)
assert(paired[2] == 3 && paired[3] == 4)

let timed = verletStep(ramp, [0.0, 0.0], 2, 0.1)
assert(abs(timed[0] - 0.01) < 1e-14)
assert(abs(timed[1] - 0.205) < 1e-14)

var wide: [Float64] = []
for i in 0..<32:
    wide.append(0.0)
for i in 0..<32:
    wide.append(1.0)
let advanced = verletStep(still, wide, 0, 0.1)
assert(advanced.count == 64)
for i in 0..<32:
    assert(abs(advanced[i] - 0.1) < 1e-14)
    assert(advanced[i + 32] == 1)
