var numbers = [1, 4]
let snapshot = numbers
numbers.insert(contentsOf: [2, 3], at: 1)
assert(numbers == [1, 2, 3, 4])
assert(snapshot == [1, 4])
numbers.append(contentsOf: [5, 6])
assert(numbers == [1, 2, 3, 4, 5, 6])
numbers.insert(contentsOf: [], at: 0)
numbers.append(contentsOf: [])
assert(numbers == [1, 2, 3, 4, 5, 6])

var selfAppend = [7, 8]
let oldSelf = selfAppend
selfAppend.append(contentsOf: selfAppend)
assert(selfAppend == [7, 8, 7, 8])
assert(oldSelf == [7, 8])
var selfInsert = [1, 2, 3]
selfInsert.insert(contentsOf: selfInsert, at: 1)
assert(selfInsert == [1, 1, 2, 3, 2, 3])

var words = ["alpha", "delta"]
let oldWords = words
words.insert(contentsOf: ["beta", "gamma"], at: 1)
words.append(contentsOf: ["epsilon"])
assert(words == ["alpha", "beta", "gamma", "delta", "epsilon"])
assert(oldWords == ["alpha", "delta"])
var emptyWords: [String] = []
emptyWords.append(contentsOf: ["ready"])
assert(emptyWords == ["ready"])

var groups = [[1], [4]]
let oldGroups = groups
groups.insert(contentsOf: [[2], [3]], at: 1)
groups.append(contentsOf: [[5]])
assert(groups == [[1], [2], [3], [4], [5]])
assert(oldGroups == [[1], [4]])

struct Holder:
    var rows: [[Int64]]
var holder = Holder([[1, 4]])
var indexCalls = 0
func rowIndex() -> Int64:
    indexCalls += 1
    return 0
holder.rows[rowIndex()].insert(contentsOf: [2, 3], at: 1)
holder.rows[rowIndex()].append(contentsOf: [5])
assert(indexCalls == 2)
assert(holder.rows[0] == [1, 2, 3, 4, 5])

var order = 0
func contents() -> [Int64]:
    order = order * 10 + 1
    return [9, 10]
func position() -> Int64:
    order = order * 10 + 2
    return 1
numbers.insert(contentsOf: contents(), at: position())
assert(order == 12)
assert(numbers == [1, 9, 10, 2, 3, 4, 5, 6])

var failure = [1, 2]
func tryInvalid() -> Int64:
    failure.insert(contentsOf: [3], at: 9)
    return 1
assert(attempt(tryInvalid()) == nil)
assert(failure == [1, 2])
